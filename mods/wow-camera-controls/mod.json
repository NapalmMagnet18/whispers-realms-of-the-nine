{
  "name": "wow-camera-controls",
  "displayName": "World of Warcraft Camera Controls",
  "description": "World of Warcraft controls, camera and movement: W/S walk, A/D turn in place, Q/E strafe, R or Num Lock autorun (A/D steer it, W or S stops it), runs by default, backpedals at walking pace with Numpad / to toggle walking. Hold left mouse to orbit around your character without turning them, right mouse to steer, both buttons run forward, wheel zooms smoothly into first person, Alt free-looks. No pointer lock, ground-hugging camera arm, steep slopes slide, swimming along the look. Touch friendly.",
  "tags": [
    "camera",
    "controls",
    "mmo",
    "third-person",
    "mouse"
  ],
  "visibility": "public",
  "version": "1.7.0",
  "inputs": {
    "actions": {
      "jump": {
        "keys": [
          "space"
        ],
        "touch": {
          "button": false
        }
      },
      "orbit": {
        "mouse": "left",
        "touch": {
          "button": false
        },
        "activeOn": "hold"
      },
      "steer": {
        "mouse": "right",
        "touch": {
          "button": false
        },
        "activeOn": "hold"
      },
      "autoRun": {
        "keys": [
          "r",
          "NumLock"
        ],
        "touch": {
          "button": false
        }
      },
      "release": {
        "keys": [
          "escape"
        ],
        "touch": {
          "button": false
        }
      },
      "freeLook": {
        "keys": [
          "alt"
        ],
        "touch": {
          "button": false
        },
        "activeOn": "hold"
      },
      "walkToggle": {
        "keys": [
          "NumpadDivide"
        ],
        "touch": {
          "button": false
        }
      },
      "autoRunStop": {
        "keys": [
          "w",
          "s"
        ],
        "touch": {
          "button": false
        }
      }
    },
    "axes": {
      "turn": {
        "keys": "a/d"
      },
      "zoom": {
        "mouse": "wheelY"
      },
      "strafe": {
        "keys": "q/e"
      },
      "forward": {
        "keys": "s/w"
      }
    }
  },
  "attach": [
    {
      "target": {
        "kind": "camera"
      },
      "behavior": "camera.js"
    }
  ]
}
