# spawn-scene v2 yaml x0z0
qm-drt-daylight:
  feetPosition: {x: -4.5, y: 0.05, z: -6}
  fx: {script: "fx\npop motes rate=5 on=disc(.5) life=1.4..2.4 v=up(.3..0.6) size=.04..0.08 acc=curl(.4)+drag(.6) col=hdr(%r|2.6,%g|1.9,%b|0.7) a=0>.2:1>.7:.8>0 sz=$size r=sprite(soft-disc,add)"}
  id: qm-drt-daylight
  rotation: 0
  state: {after: archive_kernel, burstAt: 1, burstFx: "fx\npop flare burst=36 on=sphere(.3) life=.5..1.1 v=up(1..2.4)+sdir()*.6 size=.06..0.12 acc=buoy(.4)+drag(1.2) col=hdr(2.6,2.2,1.2)>hdr(1,.5,.2) a=1>0 r=sprite(soft-disc,add)\npop glow n=1 life=1 r=light(<1,.8,.5>,10,10)", gain: Kernel in daylight, mark: kernel_daylight, quest: DRT-04, say: You raise the cutting toward the shaft. Daylight finds it for the first time in an age., title: The light shaft, verb: Lift}
  tags: [quest-mark, root-archive]
