# spawn-scene v2 yaml x0z-1
qm-drt-kernel:
  feetPosition: {x: 0, y: 0.05, z: -79}
  fx: {params: {b: 0.8, g: 2.6, r: 1.6}, script: "fx\npop motes rate=5 on=disc(.5) life=1.4..2.4 v=up(.3..0.6) size=.04..0.08 acc=curl(.4)+drag(.6) col=hdr(%r|2.6,%g|1.9,%b|0.7) a=0>.2:1>.7:.8>0 sz=$size r=sprite(soft-disc,add)"}
  id: qm-drt-kernel
  physics: static
  primitive: {kind: scripted, params: {kind: dais, layout: root-archive}, script: scripts/gen/instance.js}
  rotation: 0
  state: {burstAt: 1, burstFx: "fx\npop flare burst=36 on=sphere(.3) life=.5..1.1 v=up(1..2.4)+sdir()*.6 size=.06..0.12 acc=buoy(.4)+drag(1.2) col=hdr(2.6,2.2,1.2)>hdr(1,.5,.2) a=1>0 r=sprite(soft-disc,add)\npop glow n=1 life=1 r=light(<1,.8,.5>,10,10)", gain: Kernel planted, mark: archive_kernel, quest: DRT-04, say: "You set the kernel in the open soil of the glade. It roots at once, and remembers nothing it wasn't given freely.", title: The archive kernel, verb: Plant}
  tags: [quest-mark, root-archive]
qm-drt-thorn-2:
  feetPosition: {x: -0.12, y: 0.05, z: -78}
  fx: {params: {b: 1, g: 2.4, r: 2.4}, script: "fx\npop motes rate=5 on=disc(.5) life=1.4..2.4 v=up(.3..0.6) size=.04..0.08 acc=curl(.4)+drag(.6) col=hdr(%r|2.6,%g|1.9,%b|0.7) a=0>.2:1>.7:.8>0 sz=$size r=sprite(soft-disc,add)"}
  id: qm-drt-thorn-2
  physics: static
  primitive: {kind: scripted, params: {kind: seat, layout: root-archive}, script: scripts/gen/instance.js}
  rotation: 0
  state: {burstAt: 1, burstFx: "fx\npop flare burst=36 on=sphere(.3) life=.5..1.1 v=up(1..2.4)+sdir()*.6 size=.06..0.12 acc=buoy(.4)+drag(1.2) col=hdr(2.6,2.2,1.2)>hdr(1,.5,.2) a=1>0 r=sprite(soft-disc,add)\npop glow n=1 life=1 r=light(<1,.8,.5>,10,10)", gain: Thorn disabled, mark: bellglass_thorn, quest: DRT-03, say: The thorn rings and cracks. The Custodian flinches as if the glass were its own., title: A bellglass thorn, verb: Shatter}
  tags: [quest-mark, root-archive]
