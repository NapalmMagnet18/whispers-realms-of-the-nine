  tags: [quest-mark, hollowcrypt]
qm-dhc-echo-a:
  feetPosition: {x: -3, y: 0, z: -45}
  fx: {script: "fx\npop body rate=30 on=box(.35,1.7,.2) life=.8..1.4 v=up(.1..0.3) size=.08..0.16 acc=curl(.5)+drag(1) col=hdr(1,1.6,2.6) a=0>.3:.5>.7:.3>0 sz=$size r=sprite(soft-disc,add)\npop glow n=1 at=<0,1.1,0> r=light(<.55,.75,1>,1.6,6)"}
  id: qm-dhc-echo-a
  state: {burstAt: 0.2, burstFx: "fx\npop rise burst=60 on=box(.35,1.7,.2) life=1.2..2 v=up(1.5..3) size=.06..0.12 acc=curl(.6) col=hdr(1.4,2,3) a=1>0 r=sprite(soft-disc,add)", gain: Testimony released, mark: echo_testimony, quest: DHC-04, say: "\"They asked my name for three days. I gave them my brother's. Tell him I'm sorry.\" The voice thins, and goes.", title: An echo testimony, verb: Listen}
  tags: [quest-mark, hollowcrypt]
qm-dhc-echo-b:
  feetPosition: {x: 3, y: 0, z: -26.5}
  fx: {script: "fx\npop body rate=30 on=box(.35,1.7,.2) life=.8..1.4 v=up(.1..0.3) size=.08..0.16 acc=curl(.5)+drag(1) col=hdr(1,1.6,2.6) a=0>.3:.5>.7:.3>0 sz=$size r=sprite(soft-disc,add)\npop glow n=1 at=<0,1.1,0> r=light(<.55,.75,1>,1.6,6)"}
  id: qm-dhc-echo-b
  state: {burstAt: 0.2, burstFx: "fx\npop rise burst=60 on=box(.35,1.7,.2) life=1.2..2 v=up(1.5..3) size=.06..0.12 acc=curl(.6) col=hdr(1.4,2,3) a=1>0 r=sprite(soft-disc,add)", gain: Testimony released, mark: echo_testimony, quest: DHC-04, say: "\"I kept the east row's ledger. I wrote what they told me to strike. I'm done writing now.\" The light lets go of the shelf.", title: An echo testimony, verb: Listen}
  tags: [quest-mark, hollowcrypt]
qm-dhc-sigil-a:
  children: [{feetPosition: {x: 0, y: 1.3, z: 0}, light: {color: oklch(0.62 0.2 300), distance: 9, intensity: 6, kind: point}}]
  feetPosition: {x: 0, y: 0, z: -60.5}
  id: qm-dhc-sigil-a
  physics: static
  primitive: {kind: scripted, params: {kind: sigil}, script: scripts/gen/crypt.js}
  rotation: {lookAt: {x: 0, y: 0, z: -67}}
  state: {burstAt: 1.2, burstFx: "fx\npop shards burst=40 on=sphere(.3) life=.6..1.2 v=sdir()*(2..4)+up(1..2) size=.05..0.1 acc=grav()*.8 col=hdr(1.8,.8,2.8) a=1>0 floor=bounce(.3) r=sprite(soft-disc,add)\npop flash n=1 life=.3 r=light(<.7,.4,1>,12,10)", gain: Sigil broken, mark: warden_sigil, quest: DHC-03, say: "The rune cracks down its middle. Somewhere behind you, the Warden's crown gutters.", title: A sigil stone, verb: Break}
  tags: [quest-mark, hollowcrypt]
qm-dhc-strip-a:
  feetPosition: {x: -7.2, y: 0, z: -34.9}
  fx: {script: "fx\npop motes rate=4 on=disc(.4) life=1.4..2.2 v=up(.3..0.6) size=.04..0.07 acc=curl(.4)+drag(.6) col=hdr(2.6,1.9,.7) a=0>.2:1>.7:.8>0 sz=$size r=sprite(soft-disc,add)"}
  id: qm-dhc-strip-a
  primitive: {kind: scripted, params: {kind: lectern}, script: scripts/gen/crypt.js}
  rotation: -90
  state: {gain: Census strip recovered, mark: census_strip, quest: DHC-02, say: "A strip torn from a census roll, the ink still wet: MARROW LANE, NINE HOUSEHOLDS. STRUCK.", title: A torn census strip, verb: Take}
  tags: [quest-mark, hollowcrypt]
