qm-dhc-candle-a:
  feetPosition: {x: -5.8, y: 0, z: -8.8}
  id: qm-dhc-candle-a
  physics: static
  primitive: {kind: scripted, params: {kind: candle}, script: scripts/gen/crypt.js}
  state: {burstAt: 1.3, burstFx: "fx\npop flare burst=26 on=disc(.06) life=.4..0.9 v=up(1..2)+sdir()*.4 size=.05..0.1 acc=buoy(.6)+drag(1.2) col=hdr(4,2.6,.9)>hdr(1.6,.5,.1) a=1>0 r=sprite(flame-wisp,add)\npop glow n=1 life=1.2 r=light(<1,.6,.25>,8,8)", gain: Candle lit, mark: unclaimed_candle, quest: DHC-01, say: The wick takes. For a breath the dark leans away from it., title: An unclaimed candle, verb: Light}
  tags: [quest-mark, hollowcrypt]
