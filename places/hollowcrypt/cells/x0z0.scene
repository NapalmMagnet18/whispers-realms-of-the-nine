# spawn-scene v2 yaml x0z0
crypt-gate-in:
  behavior: scripts/crypt-gate.js
  children: [{feetPosition: {x: 0, y: 0, z: 0.1}, id: frame, material: {color: oklch(0.75 0.01 70), roughness: 0.95}, physics: static, primitive: {depth: 0.5, height: 3.7, kind: archway, thickness: 0.4, width: 3.3}}]
  feetPosition: {x: 0, y: 0.05, z: -0.75}
  id: crypt-gate-in
