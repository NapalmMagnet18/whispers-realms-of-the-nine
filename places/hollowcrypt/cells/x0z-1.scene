# spawn-scene v2 yaml x0z-1
amb-crypt-warden:
  audio: {clip: /cdn/moodboard-gothic-horror/sfx-crypt-water-drips-echo-faint-stone-grind-distant-wind-loop.mp3, gain: 0.16, loop: true, maxDistance: 40, spatial: true}
  feetPosition: {x: 0, y: 2, z: -65}
  id: amb-crypt-warden
  tags: [ambience]
candle-warden:
  behavior: scripts/candle-warden.js
  feetPosition: {x: 0, y: 0.05, z: -71}
  fx: {script: "fx\npop flame rate=40 on=arc(.35,6.283,.05) life=.3..0.6 v=up(.7..1.2) size=.06..0.12 acc=curl(.5)+buoy(1) sz=$size*(1>.3) col=hdr(4,2.4,.8)>hdr(1.8,.5,.1) a=0>.1:1>.7:.8>0 r=sprite(flame-wisp,add)\npop glow n=1 at=<0,2.9,0> r=light(<1,.62,.3>,5,10)"}
  id: candle-warden
  layout: {maxExtents: {x: 0.45, y: 1.8, z: 0.35}, minExtents: {x: -0.45, y: 0, z: -0.35}}
  material: {dissolve: 0}
  model: /cdn/model-humanoid-fantasy-candle-warden-towering-armored-knight-crown-of-candles-wax-draped-cloak.glb
  physics: character
  rotation: 0
  scale: 1.6
  state: {home: {x: 0, z: -71}, hp: 900, hpPct: 100, maxHp: 900, mode: asleep, radius: 0.7, unhurt: true}
  tags: [enemy, boss, hollowcrypt]
  ui: "<div face=\"top\" facing=\"player\" offset=\"0.6m\" width=\"1.2m\" class=\"flex flex-col items-center gap-[10px]\"><div class=\"text-[64px] font-bold text-amber-100 tracking-wide\" style=\"font-family:Cinzel,serif;text-shadow:0 3px 6px #000\">The Candle Warden</div><div hidden=\"{{ state.unhurt }}\" class=\"w-full h-[52px] rounded-md bg-black/75 border-[3px] border-amber-900 p-[5px]\"><div class=\"h-full rounded bg-orange-600\" style=\"width: {{ state.hpPct }}%\"></div></div></div>"
crypt-light-w3:
  children: [{feetPosition: {x: 0, y: 2.1, z: 0}, light: {color: oklch(0.8 0.14 68), distance: 24, intensity: 16, kind: point}}]
  feetPosition: {x: -11.5, y: 0, z: -78}
  fx: {script: "fx\npop flame rate=10 on=box(.8,.01,.8) life=.3..0.5 v=up(.4..0.7) size=.03..0.05 acc=curl(.4)+buoy(.6) sz=$size*(1>.3) col=hdr(4,2.6,.9)>hdr(1.8,.5,.1) a=0>.1:1>.7:.8>0 r=sprite(flame-wisp,add)"}
  id: crypt-light-w3
  primitive: {kind: scripted, params: {kind: candelabra}, script: scripts/gen/crypt.js}
crypt-light-w4:
  children: [{feetPosition: {x: 0, y: 2.1, z: 0}, light: {color: oklch(0.8 0.14 68), distance: 24, intensity: 16, kind: point}}]
  feetPosition: {x: 11.5, y: 0, z: -78}
  fx: {script: "fx\npop flame rate=10 on=box(.8,.01,.8) life=.3..0.5 v=up(.4..0.7) size=.03..0.05 acc=curl(.4)+buoy(.6) sz=$size*(1>.3) col=hdr(4,2.6,.9)>hdr(1.8,.5,.1) a=0>.1:1>.7:.8>0 r=sprite(flame-wisp,add)"}
  id: crypt-light-w4
  primitive: {kind: scripted, params: {kind: candelabra}, script: scripts/gen/crypt.js}
