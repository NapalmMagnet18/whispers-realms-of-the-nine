qm-dhc-index:
  children: [{feetPosition: {x: 0, y: 2, z: 0}, light: {color: oklch(0.8 0.14 68), distance: 12, intensity: 8, kind: point}}]
  feetPosition: {x: 0, y: 0, z: -77.3}
  id: qm-dhc-index
  physics: static
  primitive: {kind: scripted, params: {kind: altar}, script: scripts/gen/crypt.js}
  state: {after: echo_testimony, afterText: "First: release the two echo testimonies in the archive", burstAt: 1.4, burstFx: "fx\npop flare burst=26 on=disc(.06) life=.4..0.9 v=up(1..2)+sdir()*.4 size=.05..0.1 acc=buoy(.6)+drag(1.2) col=hdr(4,2.6,.9)>hdr(1.6,.5,.1) a=1>0 r=sprite(flame-wisp,add)\npop glow n=1 life=1.2 r=light(<1,.6,.25>,8,8)", gain: Command restored, mark: warden_command, quest: DHC-04, say: "Under your palm the old words surface through the new: GUARD THE WITNESS. The Warden's crown burns steady and gold.", title: The Warden's index stone, verb: Restore}
  tags: [quest-mark, hollowcrypt]
qm-dhc-sigil-b:
  children: [{feetPosition: {x: 0, y: 1.3, z: 0}, light: {color: oklch(0.62 0.2 300), distance: 9, intensity: 6, kind: point}}]
  feetPosition: {x: -5.6, y: 0, z: -70.2}
  id: qm-dhc-sigil-b
  physics: static
  primitive: {kind: scripted, params: {kind: sigil}, script: scripts/gen/crypt.js}
  rotation: {lookAt: {x: 0, y: 0, z: -67}}
  state: {burstAt: 1.2, burstFx: "fx\npop shards burst=40 on=sphere(.3) life=.6..1.2 v=sdir()*(2..4)+up(1..2) size=.05..0.1 acc=grav()*.8 col=hdr(1.8,.8,2.8) a=1>0 floor=bounce(.3) r=sprite(soft-disc,add)\npop flash n=1 life=.3 r=light(<.7,.4,1>,12,10)", gain: Sigil broken, mark: warden_sigil, quest: DHC-03, say: "The rune cracks down its middle. Somewhere behind you, the Warden's crown gutters.", title: A sigil stone, verb: Break}
  tags: [quest-mark, hollowcrypt]
qm-dhc-sigil-c:
  children: [{feetPosition: {x: 0, y: 1.3, z: 0}, light: {color: oklch(0.62 0.2 300), distance: 9, intensity: 6, kind: point}}]
  feetPosition: {x: 5.6, y: 0, z: -70.2}
  id: qm-dhc-sigil-c
  physics: static
  primitive: {kind: scripted, params: {kind: sigil}, script: scripts/gen/crypt.js}
  rotation: {lookAt: {x: 0, y: 0, z: -67}}
  state: {burstAt: 1.2, burstFx: "fx\npop shards burst=40 on=sphere(.3) life=.6..1.2 v=sdir()*(2..4)+up(1..2) size=.05..0.1 acc=grav()*.8 col=hdr(1.8,.8,2.8) a=1>0 floor=bounce(.3) r=sprite(soft-disc,add)\npop flash n=1 life=.3 r=light(<.7,.4,1>,12,10)", gain: Sigil broken, mark: warden_sigil, quest: DHC-03, say: "The rune cracks down its middle. Somewhere behind you, the Warden's crown gutters.", title: A sigil stone, verb: Break}
  tags: [quest-mark, hollowcrypt]
