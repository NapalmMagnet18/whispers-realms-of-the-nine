  feetPosition: {x: 0, y: 0.05, z: -52}
  id: kesh-slagmaster
  layout: {maxExtents: {x: 0.45, y: 1.8, z: 0.35}, minExtents: {x: -0.45, y: 0, z: -0.35}}
  material: {dissolve: 0}
  model: /cdn/model-humanoid-fantasy-kesh-slagmaster-massive-forge-overseer-molten-iron-apron-horned-helm-giant-ladle.glb
  physics: character
  rotation: 180
  scale: 1.8
  state: {arena: {r: 11, x: 0, z: -48}, boss: kesh_slagmaster, home: {x: 0, z: -52}, hp: 7500, hpPct: 100, maxHp: 7500, mode: asleep, radius: 0.7, title: Kesh the Slagmaster, unhurt: true, yaw: 180}
