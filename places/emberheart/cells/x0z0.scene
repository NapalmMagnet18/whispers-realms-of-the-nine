# spawn-scene v2 yaml x0z0
caldera-amb-0:
  audio: {clip: /cdn/moodboard-painterly-fantasy/sfx-lava-bubbling-deep-volcanic-rumble-loop.mp3, gain: 0.16, loop: true, maxDistance: 45, spatial: true}
  feetPosition: {x: 0, y: 2, z: -8}
  id: caldera-amb-0
  tags: [ambience]
