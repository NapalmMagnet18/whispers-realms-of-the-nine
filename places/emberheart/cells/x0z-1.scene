# spawn-scene v2 yaml x0z-1
bellglass-colossus:
  behavior: scripts/boss.js
  feetPosition: {x: 0, y: 0.05, z: -88}
  id: bellglass-colossus
  layout: {maxExtents: {x: 0.45, y: 1.8, z: 0.35}, minExtents: {x: -0.45, y: 0, z: -0.35}}
  material: {dissolve: 0}
  model: /cdn/model-humanoid-fantasy-bellglass-colossus-giant-golem-of-amber-glass-and-bronze-molten-core-visible-in-chest.glb
  physics: character
  rotation: 180
  scale: 2.2
  state: {arena: {r: 12, x: 0, z: -84}, boss: bellglass_colossus, home: {x: 0, z: -88}, hp: 9000, hpPct: 100, maxHp: 9000, mode: asleep, radius: 0.7, title: The Bellglass Colossus, unhurt: true, yaw: 180}
  tags: [enemy, boss, emberheart]
  ui: "<div face=\"top\" facing=\"player\" offset=\"0.6m\" width=\"1.4m\" class=\"flex flex-col items-center gap-[8px]\"><div class=\"text-[60px] font-bold text-amber-100 tracking-wide\" style=\"font-family:Cinzel,serif;text-shadow:0 3px 6px #000\">The Bellglass Colossus</div><div hidden=\"{{ state.unhurt }}\" class=\"w-full h-[48px] rounded-md bg-black/75 border-[3px] border-amber-900 p-[4px]\"><div class=\"h-full rounded bg-orange-600\" style=\"width: {{ state.hpPct }}%\"></div></div></div>"
caldera-amb-2:
  audio: {clip: /cdn/moodboard-painterly-fantasy/sfx-lava-bubbling-deep-volcanic-rumble-loop.mp3, gain: 0.16, loop: true, maxDistance: 45, spatial: true}
  feetPosition: {x: 0, y: 2, z: -84}
  id: caldera-amb-2
  tags: [ambience]
caldera-amb-3:
