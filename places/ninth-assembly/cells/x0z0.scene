qm-rac-ceremony:
  feetPosition: {x: 0, y: 0.05, z: -10}
  fx: {params: {b: 1, g: 2.2, r: 2.6}, script: "fx\npop motes rate=5 on=disc(.5) life=1.4..2.4 v=up(.3..0.6) size=.04..0.08 acc=curl(.4)+drag(.6) col=hdr(%r|2.6,%g|1.9,%b|0.7) a=0>.2:1>.7:.8>0 sz=$size r=sprite(soft-disc,add)"}
  id: qm-rac-ceremony
  physics: static
  primitive: {kind: scripted, params: {kind: dais, layout: ninth-assembly}, script: scripts/gen/instance.js}
  rotation: 0
  state: {burstAt: 1, burstFx: "fx\npop flare burst=36 on=sphere(.3) life=.5..1.1 v=up(1..2.4)+sdir()*.6 size=.06..0.12 acc=buoy(.4)+drag(1.2) col=hdr(2.6,2.2,1.2)>hdr(1,.5,.2) a=1>0 r=sprite(soft-disc,add)\npop glow n=1 life=1 r=light(<1,.8,.5>,10,10)", gain: Ceremony attended, mark: ceremony, quest: RAC-05, say: "Nine bells ring once each, softly. Nobody on the steps is asked for their name.", title: The remembrance ceremony, verb: Attend}
  tags: [quest-mark, ninth-assembly]
qm-rac-crest:
  feetPosition: {x: 2, y: 0.05, z: -12}
  fx: {params: {b: 1, g: 2.2, r: 2.6}, script: "fx\npop motes rate=5 on=disc(.5) life=1.4..2.4 v=up(.3..0.6) size=.04..0.08 acc=curl(.4)+drag(.6) col=hdr(%r|2.6,%g|1.9,%b|0.7) a=0>.2:1>.7:.8>0 sz=$size r=sprite(soft-disc,add)"}
  id: qm-rac-crest
  rotation: 0
  state: {after: ceremony, burstAt: 1, burstFx: "fx\npop flare burst=36 on=sphere(.3) life=.5..1.1 v=up(1..2.4)+sdir()*.6 size=.06..0.12 acc=buoy(.4)+drag(1.2) col=hdr(2.6,2.2,1.2)>hdr(1,.5,.2) a=1>0 r=sprite(soft-disc,add)\npop glow n=1 life=1 r=light(<1,.8,.5>,10,10)", gain: Crest chosen, mark: crest_chosen, quest: RAC-05, say: "You choose the plain lantern crest. It is yours, and it costs no one anything.", title: The commemorative crests, verb: Choose}
  tags: [quest-mark, ninth-assembly]
