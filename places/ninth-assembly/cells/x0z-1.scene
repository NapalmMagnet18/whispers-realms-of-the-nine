  id: qm-rac-seat-0
  physics: static
  primitive: {kind: scripted, params: {kind: seat, layout: ninth-assembly}, script: scripts/gen/instance.js}
  rotation: 270
  state: {burstAt: 1, burstFx: "fx\npop flare burst=36 on=sphere(.3) life=.5..1.1 v=up(1..2.4)+sdir()*.6 size=.06..0.12 acc=buoy(.4)+drag(1.2) col=hdr(2.6,2.2,1.2)>hdr(1,.5,.2) a=1>0 r=sprite(soft-disc,add)\npop glow n=1 life=1 r=light(<1,.8,.5>,10,10)", gain: Seat taken, mark: seat_station, quest: RAC-02, say: "You sit. For a breath the seat remembers everyone who sat here before, and none of them were kings.", title: One of the nine seats, verb: Sit}
