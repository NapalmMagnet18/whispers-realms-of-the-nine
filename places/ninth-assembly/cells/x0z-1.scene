memory-engine:
  behavior: scripts/boss.js
  feetPosition: {x: 0, y: 0.05, z: -130}
  id: memory-engine
  layout: {maxExtents: {x: 0.45, y: 1.8, z: 0.35}, minExtents: {x: -0.45, y: 0, z: -0.35}}
  material: {dissolve: 0}
  model: /cdn/model-humanoid-fantasy-memory-engine-hovering-colossus-of-brass-rings-violet-glass-and-thousands-of-tiny-floating-names-a-face-in-the-core.glb
  physics: character
  rotation: 180
  scale: 2.2
  state: {arena: {r: 16, x: 0, z: -125}, boss: memory_engine, home: {x: 0, z: -130}, hp: 13000, hpPct: 100, maxHp: 13000, mode: asleep, radius: 0.7, title: The Memory Engine, unhurt: true, yaw: 180}
  tags: [enemy, boss, ninth-assembly]
  ui: "<div face=\"top\" facing=\"player\" offset=\"0.6m\" width=\"1.4m\" class=\"flex flex-col items-center gap-[8px]\"><div class=\"text-[60px] font-bold text-amber-100 tracking-wide\" style=\"font-family:Cinzel,serif;text-shadow:0 3px 6px #000\">The Memory Engine</div><div hidden=\"{{ state.unhurt }}\" class=\"w-full h-[48px] rounded-md bg-black/75 border-[3px] border-amber-900 p-[4px]\"><div class=\"h-full rounded bg-orange-600\" style=\"width: {{ state.hpPct }}%\"></div></div></div>"
qm-rac-ledger:
  feetPosition: {x: 0, y: 0.05, z: -112}
  fx: {params: {b: 1, g: 2.2, r: 2.6}, script: "fx\npop motes rate=5 on=disc(.5) life=1.4..2.4 v=up(.3..0.6) size=.04..0.08 acc=curl(.4)+drag(.6) col=hdr(%r|2.6,%g|1.9,%b|0.7) a=0>.2:1>.7:.8>0 sz=$size r=sprite(soft-disc,add)"}
  id: qm-rac-ledger
  physics: static
  primitive: {kind: scripted, params: {kind: seat, layout: ninth-assembly}, script: scripts/gen/instance.js}
  rotation: 0
  state: {after: victim_heard, burstAt: 1, burstFx: "fx\npop flare burst=36 on=sphere(.3) life=.5..1.1 v=up(1..2.4)+sdir()*.6 size=.06..0.12 acc=buoy(.4)+drag(1.2) col=hdr(2.6,2.2,1.2)>hdr(1,.5,.2) a=1>0 r=sprite(soft-disc,add)\npop glow n=1 life=1 r=light(<1,.8,.5>,10,10)", gain: Restitution recorded, mark: restitution, quest: RAC-04, say: "You write the promises in plain ink, where anyone can read them.", title: The open ledger of restitution, verb: Record}
  tags: [quest-mark, ninth-assembly]
