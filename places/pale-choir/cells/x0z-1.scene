# spawn-scene v2 yaml x0z-1
bone-organist:
  behavior: scripts/boss.js
  feetPosition: {x: 0, y: 0.05, z: -88}
  id: bone-organist
  layout: {maxExtents: {x: 0.45, y: 1.8, z: 0.35}, minExtents: {x: -0.45, y: 0, z: -0.35}}
  material: {dissolve: 0}
  model: /cdn/model-humanoid-fantasy-bone-organist-skeletal-giant-in-tattered-choir-robes-ribcage-organ-pipes-on-back.glb
  physics: character
  rotation: 180
  scale: 1.8
  state: {arena: {r: 11, x: 0, z: -85}, boss: bone_organist, home: {x: 0, z: -88}, hp: 8000, hpPct: 100, maxHp: 8000, mode: asleep, radius: 0.7, title: The Bone Organist, unhurt: true, yaw: 180}
  tags: [enemy, boss, pale-choir]
  ui: "<div face=\"top\" facing=\"player\" offset=\"0.6m\" width=\"1.4m\" class=\"flex flex-col items-center gap-[8px]\"><div class=\"text-[60px] font-bold text-amber-100 tracking-wide\" style=\"font-family:Cinzel,serif;text-shadow:0 3px 6px #000\">The Bone Organist</div><div hidden=\"{{ state.unhurt }}\" class=\"w-full h-[48px] rounded-md bg-black/75 border-[3px] border-amber-900 p-[4px]\"><div class=\"h-full rounded bg-orange-600\" style=\"width: {{ state.hpPct }}%\"></div></div></div>"
choir-amb-2:
  audio: {clip: /cdn/moodboard-gothic-horror/sfx-empty-cathedral-low-wind-distant-choir-hum-loop.mp3, gain: 0.16, loop: true, maxDistance: 45, spatial: true}
  feetPosition: {x: 0, y: 2, z: -85}
  id: choir-amb-2
  tags: [ambience]
choir-amb-3:
  audio: {clip: /cdn/moodboard-gothic-horror/sfx-empty-cathedral-low-wind-distant-choir-hum-loop.mp3, gain: 0.16, loop: true, maxDistance: 45, spatial: true}
  feetPosition: {x: 0, y: 2, z: -124}
  id: choir-amb-3
  tags: [ambience]
