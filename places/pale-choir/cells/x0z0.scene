deacon-morrow:
  behavior: scripts/boss.js
  feetPosition: {x: 0, y: 0.05, z: -54}
  id: deacon-morrow
  layout: {maxExtents: {x: 0.45, y: 1.8, z: 0.35}, minExtents: {x: -0.45, y: 0, z: -0.35}}
  material: {dissolve: 0}
  model: /cdn/model-humanoid-fantasy-deacon-morrow-towering-priest-iron-mask-black-vestments-chained-censer.glb
  physics: character
  rotation: 180
  scale: 1.8
  state: {arena: {r: 10, x: 0, z: -52}, boss: deacon_morrow, home: {x: 0, z: -54}, hp: 7000, hpPct: 100, maxHp: 7000, mode: asleep, radius: 0.7, title: "Deacon Morrow, the Unlit", unhurt: true, yaw: 180}
  tags: [enemy, boss, pale-choir]
  ui: "<div face=\"top\" facing=\"player\" offset=\"0.6m\" width=\"1.4m\" class=\"flex flex-col items-center gap-[8px]\"><div class=\"text-[60px] font-bold text-amber-100 tracking-wide\" style=\"font-family:Cinzel,serif;text-shadow:0 3px 6px #000\">Deacon Morrow, the Unlit</div><div hidden=\"{{ state.unhurt }}\" class=\"w-full h-[48px] rounded-md bg-black/75 border-[3px] border-amber-900 p-[4px]\"><div class=\"h-full rounded bg-orange-600\" style=\"width: {{ state.hpPct }}%\"></div></div></div>"
