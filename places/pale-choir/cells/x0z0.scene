choir-amb-0:
  audio: {clip: /cdn/moodboard-gothic-horror/sfx-empty-cathedral-low-wind-distant-choir-hum-loop.mp3, gain: 0.16, loop: true, maxDistance: 45, spatial: true}
  feetPosition: {x: 0, y: 2, z: -8}
  id: choir-amb-0
  tags: [ambience]
choir-amb-1:
  audio: {clip: /cdn/moodboard-gothic-horror/sfx-empty-cathedral-low-wind-distant-choir-hum-loop.mp3, gain: 0.16, loop: true, maxDistance: 45, spatial: true}
  feetPosition: {x: 0, y: 2, z: -44}
