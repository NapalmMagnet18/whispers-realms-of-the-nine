  fx: {script: "fx\npop flame rate=26 on=disc(.25) life=.4..0.8 v=up(1.3)+cone(24)*(.3..0.7) size=.16..0.3 acc=curl(.5)+buoy(2)+drag(1.5) sz=$size*(.5>1:.7>.2) col=hdr(3.6,1.6,.4)>hdr(1.6,.4,.08) a=0>.15:1>.7:.8>0 r=sprite(flame-wisp,add)\npop glow n=1 at=<0,.6,0> r=light(<1,.55,.25>,5,10)"}
  id: kha-scav-fire
  material: {color: oklch(0.3 0.02 50), roughness: 1}
  primitive: {height: 0.12, kind: cylinder, radiusBottom: 0.6, radiusTop: 0.55}
  tags: [emberstone-cradle]
