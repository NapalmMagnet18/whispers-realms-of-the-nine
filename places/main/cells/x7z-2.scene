# spawn-scene v2 yaml x7z-2
kha-old-seal:
  feetPosition: {x: 899, y: {terrain: 0}, z: -216}
  id: kha-old-seal
  physics: static
  primitive: {kind: scripted, params: {kind: seal}, script: scripts/gen/cradle.js}
  rotation: 180
  state: {after: tunnel_scavenger, afterText: "First: drive off the scavengers", gain: "+1 Rust Seal", mark: old_seal, quest: KHA-06, say: "Nine points, rust-red. Hammered shut from the outside. Behind it, very faint, someone taps twice.", sound: /cdn/moodboard-painterly-fantasy/sfx-iron-scrape-heavy.mp3, title: The Old Seal, verb: Pry loose}
  tags: [quest-mark, emberstone-cradle]
