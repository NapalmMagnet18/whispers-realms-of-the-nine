  rotation: 74
  state: {mark: cracked_pillar, quest: KHA-02, say: "Silver dust in the crack, fine as flour. It spells nothing you can read.", sound: /cdn/moodboard-painterly-fantasy/sfx-stone-pillar-low-hum-double-ring.mp3, title: Cracked Pillar, verb: Inspect}
  tags: [quest-mark, emberstone-cradle]
