reh-mourner-0:
  feetPosition: {x: -418, y: {terrain: 0}, z: 544}
  fx: {script: "fx\npop glow n=1 at=<0,.6,0> r=light(<1,.92,.6>,1.4,4)\npop mote rate=3 on=disc(.4) life=1.5..2.5 v=up(.3..0.6) size=.04..0.08 acc=curl(.4)+drag(.6) col=<1,.92,.6>*2 a=0>.6:.6>0 r=sprite(soft-disc,add)"}
  id: reh-mourner-0
  layout: {maxExtents: {x: 0.4, y: 1.75, z: 0.3}, minExtents: {x: -0.4, y: 0, z: -0.3}}
  model: /cdn/model-humanoid-fantasy-mourner-reedbound-hooded-woven-reed-shawl-holding-small-lantern.glb
  rotation: 0
  state: {mark: mourner_spoken, quest: REH-04, say: "\"My brother mended nets on this porch. Nobody remembers his face but me. I keep saying his name so it stays heavy.\"", title: Mourner, verb: Listen}
  tags: [quest-mark, reedhaven]
reh-mourner-1:
  feetPosition: {x: -446, y: {terrain: 0}, z: 536}
  fx: {script: "fx\npop glow n=1 at=<0,.6,0> r=light(<1,.92,.6>,1.4,4)\npop mote rate=3 on=disc(.4) life=1.5..2.5 v=up(.3..0.6) size=.04..0.08 acc=curl(.4)+drag(.6) col=<1,.92,.6>*2 a=0>.6:.6>0 r=sprite(soft-disc,add)"}
  id: reh-mourner-1
  layout: {maxExtents: {x: 0.4, y: 1.75, z: 0.3}, minExtents: {x: -0.4, y: 0, z: -0.3}}
  model: /cdn/model-humanoid-fantasy-mourner-reedbound-hooded-woven-reed-shawl-holding-small-lantern.glb
  rotation: 120
  state: {mark: mourner_spoken, quest: REH-04, say: "\"The water rose in one night. Some of us got out on the roofs. Some of us got written down. Some did not.\"", title: Mourner, verb: Listen}
  tags: [quest-mark, reedhaven]
reh-mourner-2:
  feetPosition: {x: -404, y: {terrain: 0}, z: 572}
  fx: {script: "fx\npop glow n=1 at=<0,.6,0> r=light(<1,.92,.6>,1.4,4)\npop mote rate=3 on=disc(.4) life=1.5..2.5 v=up(.3..0.6) size=.04..0.08 acc=curl(.4)+drag(.6) col=<1,.92,.6>*2 a=0>.6:.6>0 r=sprite(soft-disc,add)"}
  id: reh-mourner-2
  layout: {maxExtents: {x: 0.4, y: 1.75, z: 0.3}, minExtents: {x: -0.4, y: 0, z: -0.3}}
  model: /cdn/model-humanoid-fantasy-mourner-reedbound-hooded-woven-reed-shawl-holding-small-lantern.glb
  rotation: 240
  state: {mark: mourner_spoken, quest: REH-04, say: "\"Iona weaves the names so we can hold them. A name in the hand is easier than a name in the throat.\"", title: Mourner, verb: Listen}
  tags: [quest-mark, reedhaven]
