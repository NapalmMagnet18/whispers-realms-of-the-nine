veilgate-blueprint:
  feetPosition: {x: 30, y: {terrain: 0}, z: -7605}
  fx: {script: "fx\npop motes rate=?mobile:10|22 on=box(4.2,5.5,.3).c(6) life=2.5..4.5 v=up(.25..0.6)+sdir()*.2 size=.04..0.09 acc=curl(.6)*.8+drag(.4) col=hdr(1.6,.6,3) a=0>.15:1>.7:.8>0 sz=$size*flick(3,.4) r=sprite(mote,add)\npop wisps rate=?mobile:3|6 on=box(3.5,5,.1).c(6) life=1.5..2.5 v=sdir()*.4 size=.8..1.6 acc=curl(.3)+drag(1) col=<.5,.2,1> a=0>.2:.25>.8:.15>0 sz=$size*(.6>1.4) rot=spin(.1) r=sprite(smoke-puff,add)\npop glow n=1 at=point().c(6) glo=.8+.2*flick(.6,.6) r=light(<.7,.35,1>,$glo*18,26)"}
  id: veilgate-blueprint
  physics: static
  primitive: {kind: scripted, params: {h: 14, kind: arch, w: 10}, script: scripts/gen/veil.js}
  tags: [veilgate]
