assembly-gate:
  behavior: scripts/instance-gate.js
  children: [{feetPosition: {x: 0, y: 0, z: 0.1}, id: frame, material: {color: oklch(0.6 0.02 70), roughness: 0.95, texture: cdn/texture-dark-crypt-stone-blocks.png}, physics: static, primitive: {depth: 0.7, height: 3.9, kind: archway, thickness: 0.5, width: 3.4}}, {feetPosition: {x: 0, y: 4.2, z: 0}, id: glow, light: {color: oklch(0.78 0.14 300), distance: 12, intensity: 6, kind: point}}]
  feetPosition: {x: 50, y: 124.95, z: -7540}
  id: assembly-gate
  material: {kind: scripted, script: engine/portal-ink, view: {link: "+ninth-assembly#assembly-gate-in", sound: 1, spill: 1.5}}
  physics: {body: static, trigger: true}
  primitive: {depth: 0.2, height: 3.3, kind: arch, width: 2.5}
  rotation: 0
  state: {enterQuest: END-01, enterTally: assembly_entered, link: "+ninth-assembly#assembly-gate-in", minLevel: 60, name: Assembly of the Ninth}
  tags: [portal, instance-gate]
  ui: "<div face=\"top\" facing=\"player\" offset=\"0.5m\" width=\"1.6m\" class=\"flex flex-col items-center\"><div class=\"text-[56px] font-bold text-amber-100\" style=\"font-family:Cinzel,serif;text-shadow:0 3px 6px #000\">Assembly of the Ninth</div><div class=\"text-[34px] text-amber-200/80\" style=\"font-family:Cinzel,serif\">Raid · level 60+</div></div>"
engine-manifestation:
  behavior: scripts/boss.js
  feetPosition: {x: 62, y: 129.75, z: -7592}
  id: engine-manifestation
  layout: {maxExtents: {x: 0.45, y: 1.8, z: 0.35}, minExtents: {x: -0.45, y: 0, z: -0.35}}
  material: {dissolve: 0}
  model: /cdn/model-humanoid-fantasy-memory-engine-manifestation-clockwork-wraith-brass-gears-violet-glass-heart.glb
  physics: character
  rotation: 180
  scale: 1.7
  state: {arena: {r: 13, x: 62, z: -7592}, boss: engine_manifestation, home: {x: 62, z: -7592}, hp: 9800, hpPct: 100, maxHp: 9800, mode: asleep, radius: 0.75, title: Manifestation of the Memory Engine, unhurt: true, yaw: 180}
