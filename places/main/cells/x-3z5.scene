  rotation: {yaw: 0}
  state: {mark: loose_braid, quest: REH-11, say: "Over, under, through. You say the name as you knot it.", title: Loosened Name-Braid, verb: Retie}
  tags: [quest-mark, homecoming]
reh-apoth-brew:
  feetPosition: {x: -433.2846349162, y: 12.95, z: 589.6156065495645}
