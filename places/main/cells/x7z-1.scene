  state: {after: cracked_pillar, afterText: "First: inspect the cracked pillars", mark: pillar_tone, quest: KHA-02, say: "Three pillars, three tones. Read in order they make a word in a script older than the quarry.", sound: /cdn/moodboard-painterly-fantasy/sfx-tuning-fork-stone-ring.mp3, title: Tuning Hammer, verb: Strike the pillars}
  tags: [quest-mark, emberstone-cradle]
