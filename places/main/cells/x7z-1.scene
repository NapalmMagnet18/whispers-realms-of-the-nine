  rotation: 0
  state: {mark: lintel_names, quest: KHA-07, say: "Twelve names from the tokens, in plain letters. You leave a hand's width of blank stone after the last one.", sound: /cdn/moodboard-painterly-fantasy/sfx-chisel-on-stone-taps.mp3, title: The New Lintel, verb: Cut the names}
  tags: [quest-mark, emberstone-cradle]
kha-pillar-0:
  feetPosition: {x: 925, y: {terrain: -0.3}, z: -180}
  id: kha-pillar-0
  physics: static
  primitive: {kind: scripted, params: {kind: pillar}, script: scripts/gen/cradle.js}
  rotation: 0
  state: {mark: cracked_pillar, quest: KHA-02, say: "The crack runs straight, then hooks. Like the downstroke of a letter.", sound: /cdn/moodboard-painterly-fantasy/sfx-stone-pillar-low-hum-double-ring.mp3, title: Cracked Pillar, verb: Inspect}
  tags: [quest-mark, emberstone-cradle]
kha-pillar-1:
  feetPosition: {x: 929, y: {terrain: -0.3}, z: -188}
