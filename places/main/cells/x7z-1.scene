# spawn-scene v2 yaml x7z-1
start-cinderhold:
  feetPosition: {x: 900, y: 30, z: -170}
  id: start-cinderhold
  material: {kind: scripted, script: engine/blueprint}
  physics: none
  primitive: {depth: 40, height: 12, kind: box, width: 40}
  tags: [blueprint]
waystone-highlands:
  feetPosition: {x: 844, y: {terrain: 0}, z: -157}
  id: waystone-highlands
  physics: static
  primitive: {kind: scripted, params: {r: 1.6}, script: scripts/gen/rock.js}
waystone-highlands-glow:
  feetPosition: {x: 844, y: {terrain: 3.2}, z: -157}
  id: waystone-highlands-glow
  light: {color: oklch(0.82 0.14 70), distance: 14, intensity: 2.2, kind: point}
