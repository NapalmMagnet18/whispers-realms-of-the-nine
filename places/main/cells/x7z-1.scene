kha-bellglass:
  feetPosition: {x: 891.5, y: {terrain: 0}, z: -161.6}
  fx: {script: "fx\npop glow n=1 at=<0,.2,0> r=light(<.8,.5,1>,2,4)"}
  id: kha-bellglass
  physics: none
  primitive: {kind: scripted, params: {kind: shard}, script: scripts/gen/cradle.js}
  rotation: 0
  state: {after: copper_bar, afterText: "First: smelt a copper bar", mark: bellglass_compare, quest: KHA-05, say: "The bar is heavy and dull. The shard is light as a held breath, and when you lift it, it sighs.", sound: /cdn/moodboard-painterly-fantasy/sfx-glass-chime-soft.mp3, title: Bellglass Shard, verb: Weigh it}
  tags: [quest-mark, emberstone-cradle]
kha-chisel-bench:
  feetPosition: {x: 896, y: {terrain: 0}, z: -181}
  fx: {script: "fx\npop glint rate=1.5 on=disc(.2) life=.6..1 v=up(.2) size=.05..0.09 col=hdr(3,2.4,1) a=0>1:.3>0 r=sprite(soft-disc,add)"}
  id: kha-chisel-bench
  physics: static
  primitive: {kind: scripted, params: {kind: chisel}, script: scripts/gen/cradle.js}
  rotation: 20
  state: {after: copper_node, afterText: "First: mine the copper seams", mark: novice_chisel, quest: KHA-01, say: "You strike the mended chisel on the bench. It rings once. Then, a breath later, a second time, from somewhere under your feet.", sound: /cdn/moodboard-painterly-fantasy/sfx-anvil-hammer-clang.mp3, title: Stump Bench, verb: Mend the chisel}
  tags: [quest-mark, emberstone-cradle]
