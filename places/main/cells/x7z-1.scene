start-cinderhold/start-cinderhold-forge-coals:
  feetPosition: {x: -13.538468505132414, y: 1.46, z: 3.8681338586092693}
  fx: {script: "fx\npop coals n=16 on=box(.45,.05,.3) size=.08..0.16 tint=<2.8,1,.25>..<1.3,.35,.08> sz=$size*flick(.5,.15) col=$tint*flick(.9,.35) a=.95 r=sprite(soft-disc,add)\npop flame rate=flick(.6,.3)*30 on=box(.4,.02,.25) life=.3..0.6 v=up(1.1)+cone(20)*(.2..0.5) size=.14..0.26 acc=curl(.6)+buoy(2)+drag(1.6) sz=$size*(.6>1:.6>.2) col=hdr(4.4,2.6,.9)>hdr(2.4,.7,.12)>hdr(.6,.12,.03) a=0>.15:.9>0 rot=spin(.2) r=sprite(flame-wisp,add)\npop sparks rate=flick(.3,.8)*8 on=box(.4,.02,.25) life=.4..0.9 v=up(2.6..4)+cone(35)*(.6..1.5) size=.015..0.03 acc=grav()*.6+drag(.4) col=hdr(5,2.6,.7)>hdr(2,.5,.1) a=1>0 r=sprite(ember,add,velocity,.025)\npop smoke on=@flame?.3 inh=p;v:$v*.5 life=2..3.4 size=.2..0.3 acc=buoy(1)+curl(.3)*.5+drag(.8) sz=$size*(.7>3.6) col=<.26,.24,.23>><.14,.14,.15> a=0>.22:.25>.7:.18>0 rot=spin(.15) r=sprite(smoke-puff,alpha)\npop heat n=1 at=point().c(.6) glo=fire()*(#flame/20)~ r=light(<1,.5,.2>,$glo*28,13)"}
  id: start-cinderhold/start-cinderhold-forge-coals
  parent: start-cinderhold
