  rotation: 0
  state: {after: shift_token, afterText: "First: find the three shift tokens", mark: missing_crew, quest: KHA-03, say: "Every crew, every name, every week for forty years. Night Crew Nine is on none of them. Twelve tags' worth of empty nails.", title: Shift Roster, verb: Check the roster}
  tags: [quest-mark, emberstone-cradle]
