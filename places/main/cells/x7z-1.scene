  primitive: {kind: scripted, params: {kind: pillar}, script: scripts/gen/cradle.js}
  rotation: 37
  state: {mark: cracked_pillar, quest: KHA-02, say: "Your palm on the stone. It is warm, and very faintly humming.", sound: /cdn/moodboard-painterly-fantasy/sfx-stone-pillar-low-hum-double-ring.mp3, title: Cracked Pillar, verb: Inspect}
  tags: [quest-mark, emberstone-cradle]
