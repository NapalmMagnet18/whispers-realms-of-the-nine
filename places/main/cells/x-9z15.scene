  primitive: {depth: 1, height: 1, kind: box, width: 1}
  state: {gain: Dry dock searched, mark: drydock_searched, quest: TID-04, say: "The cradle timbers are dark with salt water, and the slipway's still dripping. Nothing has launched here in eleven years.", title: the empty dry dock, verb: Search}
