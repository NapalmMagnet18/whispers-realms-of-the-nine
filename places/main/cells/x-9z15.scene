# spawn-scene v2 yaml x-9z15
qm-tid-collector:
  audio: {clip: /cdn/moodboard-painterly-fantasy/sfx-arcane-siphon-machine-low-hum-loop.mp3, gain: 0.15, loop: true, maxDistance: 30, spatial: true}
  feetPosition: {x: -1175, y: 1.05, z: 1891}
  fx: {script: "fx\npop steam rate=5 on=disc(.1) pos=<0,4,0> life=1.5..2.5 v=up(1..1.6) size=.25..0.4 acc=buoy(.4)+curl(.3)+drag(.8) sz=$size*(.6>2.4) col=<.55,.45,.6> a=0>.3:.4>0 r=sprite(smoke-puff,alpha)\npop glow n=1 pos=<0,2,0> r=light(<.75,.35,1>,4,14)"}
  id: qm-tid-collector
  physics: static
  primitive: {kind: scripted, params: {kind: collector}, script: scripts/gen/tide.js}
  rotation: 160
  state: {after: memory_freed, afterText: "First: free the memory-forms from the Court nets", burstAt: 2, burstFx: "fx\npop puff burst=30 life=.8..1.6 on=disc(.6) v=up(1..2)+sdir()*.8 size=.3..0.5 acc=buoy(.3)+drag(1) sz=$size*(.5>2) col=<.4,.3,.45> a=.5>0 r=sprite(smoke-puff,alpha)", gain: Collector shut down, mark: brine_collector, quest: TID-06, say: "You wrench the valve shut. The violet glow chokes and drains out of the tank, and the hoses go slack in the surf. The sand around it stays black.", title: the brine collector, verb: Shut down}
  tags: [quest-mark, tideglass]
qm-tid-drydock-a:
  feetPosition: {x: -1195.4551156035936, y: {terrain: 0.1}, z: 1945.9845158979037}
