# spawn-scene v2 yaml x-2z2
bloom-reed-2-a:
  feetPosition: {x: -209, y: {terrain: 0}, z: 205}
  fx: {script: "fx\npop petals rate=?mobile:1|2.5 on=disc(9).c(4) life=5..8 v=<.4,-.35,.2>+sdir()*.2 size=.05..0.08 spin=-4..4 acc=curl(.4)*.6+drag(.4) col=<1,.78,.85> a=0>.1:1>.85:1>0 sz=$size rot=$age*$spin floor=stick r=sprite(soft-disc,alpha)\npop flies n=?mobile:3|7 on=disc(8).c(1) life=4..7 v=sdir()*.15 acc=curl(.6)*.5 size=.04..0.06 col=hdr(3,2.4,.8) a=(0>.2:1>.8:1>0)*flick(2,.6) sz=$size r=sprite(soft-disc,add)"}
  id: bloom-reed-2-a
  scatter: {bounds: {radius: 13, shape: circle}, count: 70, templates: [{primitive: {kind: scripted, params: {kind: wildflowers}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 6}, {primitive: {kind: scripted, params: {kind: lupine}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 2.5}, {primitive: {kind: scripted, params: {kind: rosebush}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 1}, {physics: {body: static, collider: auto}, primitive: {kind: scripted, params: {kind: blossom}, script: scripts/gen/flora.js}, visibleRange: {max: 600, min: 0}, weight: 0.9}], variation: {scale: [0.8, 1.25], yaw: [0, 360]}}
  tags: [foliage, bloom]
fen-deadwood:
  feetPosition: {x: -260, y: {terrain: -0.1}, z: 240}
  id: fen-deadwood
  scatter: {bounds: {radius: 90, shape: circle}, count: 40, templates: [{model: /cdn/value.f4f4066eaf00d08c0d9c372b2d350763da1546965bc450acfc4ceacacd03f4a6.glb, physics: {body: static, collider: capsule}, weight: 1}, {model: /cdn/value.b870253a285c88c99a4874784255c347c932c4900f2e1d904e8edb852ce06e2e.glb, physics: {body: static, collider: capsule}, weight: 1}], variation: {scale: [0.9, 1.6], yaw: [0, 360]}}
  tags: [kit-trees]
glade-briarwild-3:
  overrides:
    feetPosition: {x: -260, y: 2.5211379039600352, z: 210}
    fx: {params: {b: 1.4, g: 1.8, lb: 0.7, lg: 1, lr: 0.55, r: 0.6, spread: 12}, script: "fx\npop wisp n=?low:3|6 on=disc(%spread|10).c(1.2) life=7..12 v=sdir()*(.15..0.3) size=.16..0.26 acc=curl(.12)*.9+noise(.3)*.25+drag(.6)+attract(.02)\n  sz=$size*flick(1.6,.35) col=<%r|0.55,%g|1.6,%b|2.4>*(.8>1.3:.5>.8) a=0>.15:1>.8:1>0 r=sprite(soft-disc,add)\npop halo on=@wisp?.35 inh=p life=.5..0.9 size=.5..0.8 col=<%r|0.55,%g|1.6,%b|2.4>*.25 a=.5>0 sz=$size*(.7>1.2) r=sprite(soft-disc,add)\npop trail on=@wisp?.9 inh=p life=.6..1.2 v=sdir()*.05 size=.03..0.06 acc=grav()*.03+drag(1) col=<%r|0.55,%g|1.6,%b|2.4>*.8 a=.8>0 r=sprite(mote,add)\npop firefly n=?low:8|18 on=disc(%spread|10).c(.6) life=4..8 v=sdir()*(.2..0.4) size=.035..0.06 acc=curl(.35)*1.2+drag(.9)\n  col=hdr(2.2,2.6,.6) a=(0>.1:1>.9:1>0)*(flick(.7,1)~) r=sprite(soft-disc,add)\npop pollen n=?low:14|40 on=box(%spread|10,2.2,%spread|10).c(1.6) life=8..14 v=sdir()*.05 size=.012..0.025 acc=curl(.08)*.25+wind()*.1+drag(.4)\n  col=<1,.92,.7> a=0>.2:.55>.8:.55>0 r=sprite(mote,add)\npop glow n=1 at=point().c(1.4) gl=(#wisp/6)~*flick(.4,.25) r=light(<%lr|0.5,%lg|0.85,%lb|1>,$gl*2.4,%spread|10)"}
  template: templates/glade.js#wisps
march-caravan-bells:
  audio: {clip: /cdn/moodboard-painterly-fantasy/sfx-wagon-charms-tinkling-wind-mule-snort-loop.mp3, gain: 0.15, loop: true, maxDistance: 22, spatial: true}
  feetPosition: {x: -241.4, y: 12.5, z: 275.2}
  id: march-caravan-bells
march-caravan-goods:
  feetPosition: {x: -239.5, y: 10.6, z: 277}
  id: march-caravan-goods
  physics: kinematic
  primitive: {kind: scripted, params: {kind: goods, seed: 2}, script: scripts/gen/caravan.js}
  rotation: {yaw: -37}
  tags: [march-caravan]
march-caravan-lamp:
  feetPosition: {x: -242.6, y: 13.28, z: 276.8}
  id: march-caravan-lamp
  light: {color: "#ffbe70", distance: 9, intensity: 3, kind: point}
march-caravan-wagon:
  behavior: scripts/caravan-route.js
  feetPosition: {x: -241.4, y: 11, z: 275.2}
  id: march-caravan-wagon
  physics: kinematic
  primitive: {kind: scripted, params: {kind: wagon}, script: scripts/gen/caravan.js}
  rotation: {yaw: -37}
  state: {homeYaw: -37}
  tags: [march-caravan]
march-npc-mott:
  behavior: [scripts/townsfolk.js]
  feetPosition: {x: -239.5, y: 10.52, z: 275.5}
  id: march-npc-mott
  model: /cdn/model-humanoid-fantasy-travelling-peddler-male-patched-coat-wide-brim-hat-satchels-grey-stubble.glb
  physics: {body: kinematic, collider: capsule}
  rotation: {yaw: -127}
  state: {homeYaw: -127, idle: idle, npcName: "Mott Farwander, Peddler", shop: mott-fen, who: mott, yaw: -127}
  tags: [npc, vendor, interactable, merchant-npc, townsfolk]
reed-road-lamp-6:
  children: [{feetPosition: {x: 0.63, y: 2.45, z: 0}, light: {color: oklch(0.82 0.13 65), distance: 12, intensity: 3, kind: point}}]
  feetPosition: {x: -254.72, y: 16.82, z: 311.46}
  id: reed-road-lamp-6
