# spawn-scene v2 yaml x0z-2
ashen-lamp-1:
  children: [{feetPosition: {x: 0, y: 2.66, z: -0.9}, id: lantern, light: {color: oklch(0.8 0.14 70), distance: 12, intensity: 2, kind: point}, primitive: {kind: scripted, params: {chain: 0.3, kind: lantern}, script: scripts/gen/ashen.js, seed: 5}}]
  feetPosition: {x: 40, y: 9.139251580276657, z: -198}
  id: ashen-lamp-1
  physics: static
  primitive: {kind: scripted, params: {kind: lamppost}, script: scripts/gen/ashen.js, seed: 90}
  rotation: {yaw: 0}
  tags: [ashen]
ashen-signpost:
  children: [{feetPosition: {x: 0, y: 1.55, z: -0.12}, id: ashen-signboard, material: {color: oklch(0.9 0.02 70), texture: cdn/texture-old-dark-oak-planks.png}, primitive: {depth: 0.06, height: 0.36, kind: box, width: 1.3}, ui: "<div face=\"back\" class=\"w-full h-full flex items-center justify-center\" style=\"font-family:Cinzel,serif;color:#f2d9a0;font-size:150px;letter-spacing:6px\">ASHEN CLOSE &#8594;</div>"}]
  feetPosition: {x: 5, y: {terrain: 0}, z: -198}
  id: ashen-signpost
  physics: static
  primitive: {kind: scripted, params: {kind: signpost}, script: scripts/gen/hamlet.js}
  rotation: 180
  tags: [ashen]
ashen-woodpile-2:
  feetPosition: {x: 60, y: 5.01, z: -197}
  id: ashen-woodpile-2
  physics: static
  primitive: {kind: scripted, params: {L: 2.2, kind: woodpile}, script: scripts/gen/ashen-village.js}
  rotation: {yaw: -90}
  tags: [ashen]
bloom-north-0-a:
  feetPosition: {x: 28, y: {terrain: 0}, z: -213}
  fx: {script: "fx\npop petals rate=?mobile:1|2.5 on=disc(9).c(4) life=5..8 v=<.4,-.35,.2>+sdir()*.2 size=.05..0.08 spin=-4..4 acc=curl(.4)*.6+drag(.4) col=<1,.78,.85> a=0>.1:1>.85:1>0 sz=$size rot=$age*$spin floor=stick r=sprite(soft-disc,alpha)\npop flies n=?mobile:3|7 on=disc(8).c(1) life=4..7 v=sdir()*.15 acc=curl(.6)*.5 size=.04..0.06 col=hdr(3,2.4,.8) a=(0>.2:1>.8:1>0)*flick(2,.6) sz=$size r=sprite(soft-disc,add)"}
  id: bloom-north-0-a
  scatter: {bounds: {radius: 13, shape: circle}, count: 70, templates: [{primitive: {kind: scripted, params: {kind: wildflowers}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 6}, {primitive: {kind: scripted, params: {kind: lupine}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 2.5}, {primitive: {kind: scripted, params: {kind: rosebush}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 1}, {physics: {body: static, collider: auto}, primitive: {kind: scripted, params: {kind: blossom}, script: scripts/gen/flora.js}, visibleRange: {max: 600, min: 0}, weight: 0.9}, {physics: {body: static, collider: auto}, primitive: {kind: scripted, params: {kind: willow}, script: scripts/gen/flora.js}, visibleRange: {max: 600, min: 0}, weight: 0.4}], variation: {scale: [0.8, 1.25], yaw: [0, 360]}}
  tags: [foliage, bloom]
