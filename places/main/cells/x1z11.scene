# spawn-scene v2 yaml x1z11
bloom-tide-4:
  feetPosition: {x: 190, y: {terrain: 0}, z: 1448}
  fx: {script: "fx\npop flies n=?mobile:3|7 on=disc(8).c(1) life=4..7 v=sdir()*.15 acc=curl(.6)*.5 size=.04..0.06 col=hdr(3,2.4,.8) a=(0>.2:1>.8:1>0)*flick(2,.6) sz=$size r=sprite(soft-disc,add)"}
  id: bloom-tide-4
  scatter: {bounds: {radius: 9, shape: circle}, count: 40, templates: [{primitive: {kind: scripted, params: {kind: wildflowers, palette: tide}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 6}, {primitive: {kind: scripted, params: {kind: rosebush, palette: tide}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 2}, {primitive: {kind: scripted, params: {kind: lupine, palette: tide}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 1.5}, {physics: {body: static, collider: auto}, primitive: {kind: scripted, params: {kind: blossom, palette: tide}, script: scripts/gen/flora.js}, visibleRange: {max: 600, min: 0}, weight: 0.4}], variation: {scale: [0.8, 1.25], yaw: [0, 360]}}
  tags: [foliage, bloom]
