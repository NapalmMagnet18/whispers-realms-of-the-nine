hc-nam-summons:
  feetPosition: {x: 246.4, z: 1427}
  fx: {script: "fx\npop glow n=1 at=<0,.7,0> r=light(<1,.92,.6>,1.6,5)\npop mote rate=3 on=disc(.5) life=1.5..2.5 v=up(.3..0.6) size=.04..0.08 acc=curl(.4)+drag(.6) col=<1,.92,.6>*2 a=0>.6:.6>0 r=sprite(soft-disc,add)"}
  id: hc-nam-summons
  physics: static
  primitive: {kind: scripted, params: {kind: boat, seed: 31}, script: scripts/gen/fen.js}
  state: {mark: nam_summons, quest: NAM-10, say: The mooring rope is wet. Fresh-wet. The Wake tied up here last night., title: The Empty Mooring, verb: Examine}
  tags: [quest-mark, homecoming]
nam-buoy-0:
  feetPosition: {x: 214, y: 0.1, z: 1405}
  fx: {script: "fx\npop glow n=1 pos=<0,1.5,0> r=light(<1,.75,.4>,2,7)"}
  id: nam-buoy-0
  physics: static
  primitive: {kind: scripted, params: {kind: buoy}, script: scripts/gen/strand.js}
  rotation: 0
  state: {burstAt: 0.4, burstFx: "fx\npop ring burst=1 life=1.2 size=1.2 sz=$size*(.2>2.4) col=hdr(1.2,1.8,2.2) a=.8>0 r=sprite(soft-disc,add)", mark: ferry_lane, quest: NAM-08, say: "The first buoy. Its lamp burns steady, the way an honest light should.", sound: /cdn/moodboard-painterly-fantasy/sfx-bell-buoy-ding.mp3, title: Ferry Buoy, verb: Touch}
  tags: [quest-mark, breakwater-strand]
nam-buoy-1:
  feetPosition: {x: 221, y: 0.1, z: 1397}
  fx: {script: "fx\npop glow n=1 pos=<0,1.5,0> r=light(<1,.75,.4>,2,7)"}
  id: nam-buoy-1
  physics: static
  primitive: {kind: scripted, params: {kind: buoy}, script: scripts/gen/strand.js}
  rotation: 0
  state: {burstAt: 0.4, burstFx: "fx\npop ring burst=1 life=1.2 size=1.2 sz=$size*(.2>2.4) col=hdr(1.2,1.8,2.2) a=.8>0 r=sprite(soft-disc,add)", mark: ferry_lane, quest: NAM-08, say: "The second. The current pulls you along the lane, gently, like a hand at your back.", sound: /cdn/moodboard-painterly-fantasy/sfx-bell-buoy-ding.mp3, title: Ferry Buoy, verb: Touch}
  tags: [quest-mark, breakwater-strand]
nam-buoy-2:
  feetPosition: {x: 229, y: 0.1, z: 1393}
  fx: {script: "fx\npop glow n=1 pos=<0,1.5,0> r=light(<1,.75,.4>,2,7)"}
  id: nam-buoy-2
  physics: static
  primitive: {kind: scripted, params: {kind: buoy}, script: scripts/gen/strand.js}
  rotation: 0
  state: {burstAt: 0.4, burstFx: "fx\npop ring burst=1 life=1.2 size=1.2 sz=$size*(.2>2.4) col=hdr(1.2,1.8,2.2) a=.8>0 r=sprite(soft-disc,add)", mark: ferry_lane, quest: NAM-08, say: "The last buoy. Beyond it the water runs north, toward the rivers and the Reach.", sound: /cdn/moodboard-painterly-fantasy/sfx-bell-buoy-ding.mp3, title: Ferry Buoy, verb: Touch}
  tags: [quest-mark, breakwater-strand]
nam-chart-table:
  feetPosition: {x: 240.4, y: {terrain: 0}, z: 1439.6}
  id: nam-chart-table
  physics: static
  primitive: {kind: scripted, params: {kind: chart}, script: scripts/gen/strand.js}
  rotation: 20
  tags: [breakwater-strand]
nam-compass:
  feetPosition: {x: 240.4, y: {terrain: 0.95}, z: 1439.6}
  fx: {script: "fx\npop glint rate=1.5 on=disc(.2) life=.6..1 v=up(.2) size=.05..0.09 col=hdr(2,2.6,3) a=0>1:.3>0 r=sprite(soft-disc,add)"}
  id: nam-compass
  physics: none
  primitive: {kind: scripted, params: {kind: token}, script: scripts/gen/cradle.js}
  rotation: 0
  state: {after: null, mark: tideglass_compass, quest: NAM-07, say: "Glass, chart, verse. The needle shivers, then swings past north and settles on a point at sea where no chart shows anything at all.", sound: /cdn/moodboard-painterly-fantasy/sfx-brass-compass-click.mp3, title: Chart Table, verb: Set the compass}
  tags: [quest-mark, breakwater-strand]
nam-conch:
  feetPosition: {x: 238.6, y: {terrain: 0}, z: 1435.4}
  id: nam-conch
  physics: static
  primitive: {kind: scripted, params: {kind: conch}, script: scripts/gen/strand.js}
  rotation: 60
  state: {after: shell_echo, afterText: "First: gather the four humming shells", mark: hollow_conch, quest: NAM-02, say: "Surf. Then, under it, oars. Rope on a cleat. A child, counting waves: seven, eight, nine...", sound: /cdn/moodboard-painterly-fantasy/sfx-conch-shell-ocean-whisper.mp3, title: Great Conch, verb: Listen}
  tags: [quest-mark, breakwater-strand]
nam-current:
  feetPosition: {x: 226.4, y: 3, z: 1406.6}
  id: nam-current
  physics: none
  primitive: {kind: scripted, params: {kind: fishspot}, script: scripts/gen/strand.js}
  rotation: 225
  state: {after: tide_mark, afterText: "First: read the three tide posts", mark: reversed_current, quest: NAM-01, say: "A cork drifts off the pier end. It doesn't go out to sea. It turns, slowly, and heads inland, toward the orchards.", sound: /cdn/moodboard-painterly-fantasy/sfx-gentle-waves-shore.mp3, title: Pier End, verb: Watch the current}
  tags: [quest-mark, breakwater-strand]
nam-fishing:
  feetPosition: {x: 227.6, y: 3, z: 1405.2}
  id: nam-fishing
  physics: none
  primitive: {kind: scripted, params: {kind: fishspot}, script: scripts/gen/strand.js}
  rotation: 45
  state: {gain: "+1 Reef Fish", mark: reef_fish, quest: NAM-04, repeat: true, sound: /cdn/moodboard-painterly-fantasy/sfx-fishing-line-splash-reel.mp3, title: Fishing Spot, verb: Cast a line, waitText: Nothing biting. Give it a moment...}
  tags: [quest-mark, breakwater-strand]
nam-lamp-0:
  feetPosition: {x: 226, y: {terrain: -0.2}, z: 1445}
  id: nam-lamp-0
  physics: static
  primitive: {kind: scripted, params: {kind: lamp}, script: scripts/gen/strand.js}
  rotation: 0
  state: {burstAt: 2.4, burstFx: "fx\npop spark burst=30 life=.5..1 v=sdir()*(1.5..3) size=.04..0.08 acc=grav()*.5+drag(1) col=hdr(4,2.4,.8)>hdr(1.5,.4,.1) a=1>0 r=sprite(ember,add,velocity,.02)\npop glow burst=1 life=.6 r=light(<1,.7,.4>,12*(1>0),12)", mark: coast_lamp, quest: NAM-03, say: "The wick takes. Out on the water, a fishing boat turns toward it.", sound: /cdn/moodboard-painterly-fantasy/sfx-lantern-ignite-whoosh.mp3, title: Coast Lamp, verb: Relight}
  tags: [quest-mark, breakwater-strand]
