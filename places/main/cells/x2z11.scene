gull-bloom-arch:
  castShadow: true
  children: [{feetPosition: {x: 0, y: 3.3, z: 0}, light: {color: oklch(0.82 0.13 65), distance: 10, intensity: 3, kind: point}}]
  feetPosition: {x: 262, y: 11.758771327309285, z: 1406}
  fx: {script: "fx\npop petals rate=?mobile:1|2 on=box(<3,.5,.6>).c(4.4) life=4..7 v=<.3,-.4,.1>+sdir()*.2 size=.05..0.08 spin=-4..4 acc=curl(.4)*.6+drag(.4) col=<.85,.92,1> a=0>.1:1>.85:1>0 sz=$size rot=$age*$spin floor=stick r=sprite(soft-disc,alpha)"}
