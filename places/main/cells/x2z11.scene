  fx: {script: "fx\npop gull n=5 on=box(14,2,14).c(16) life=8..14 size=.35..0.5 acc=curl(.08)*2+drag(.3) sz=$size*(.7+flick(2.2,.6)*.3) col=<.95,.95,.92> a=0>.1:.9>.85:.9>0 r=sprite(leaf,alpha,velocity,.02)"}
  id: start-gullrest
  physics: static
  primitive: {kind: scripted, params: {kind: plate}, script: scripts/gen/hamlet.js}
  tags: [start-zone, gullrest]
