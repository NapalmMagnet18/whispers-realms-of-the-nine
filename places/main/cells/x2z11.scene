  feetPosition: {x: 249.1, z: 1435}
  fx: {script: "fx\npop glow n=1 at=<0,.7,0> r=light(<.5,.9,1.2>,1.6,5)\npop mote rate=3 on=disc(.5) life=1.5..2.5 v=up(.3..0.6) size=.04..0.08 acc=curl(.4)+drag(.6) col=<.5,.9,1.2>*2 a=0>.6:.6>0 r=sprite(soft-disc,add)"}
