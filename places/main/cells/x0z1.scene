  primitive: {kind: scripted, params: {kind: shell}, script: scripts/gen/strand.js}
  rotation: 0
  state: {after: footpath_opened, afterText: "First: open the footpath", gain: "+1 Return Marker placed", mark: return_marker, quest: PAT-06, sound: /cdn/moodboard-painterly-fantasy/sfx-wooden-stake-hammer.mp3, title: Return Marker Spot, verb: Drive a marker}
  tags: [quest-mark, wayfarers-lodge]
pat-rope:
  feetPosition: {x: -48.5, y: {terrain: 0}, z: 109}
  id: pat-rope
  physics: static
  primitive: {kind: scripted, params: {kind: ropeposts}, script: scripts/gen/lodge.js}
  rotation: 90
  state: {after: crossing_surveyed, afterText: "First: survey both shallows", mark: rope_bridge, quest: PAT-03, say: "Post, knot, wade, post, knot. The line stretches taut over the south shallow. Rowan will grumble that it's well done.", sound: /cdn/moodboard-painterly-fantasy/sfx-rope-creak-tighten.mp3, title: Rope Line, verb: Rig the rope}
  tags: [quest-mark, wayfarers-lodge]
pat-sign-0:
  feetPosition: {x: -22, y: {terrain: 0}, z: 68}
  id: pat-sign-0
  physics: static
  primitive: {kind: scripted, params: {kind: sign}, script: scripts/gen/lodge.js}
  rotation: 200
  state: {mark: trail_sign, quest: PAT-01, say: "Carved arrow: south, and a little notch that means 'water near'.", sound: /cdn/moodboard-painterly-fantasy/sfx-quest-objective-chime.mp3, title: Trail Sign, verb: Read the sign}
  tags: [quest-mark, wayfarers-lodge]
