# spawn-scene v2 yaml x0z1
lodge-hall:
  children: [{feetPosition: {x: 0, y: 2, z: 0}, light: {color: oklch(0.85 0.12 70), distance: 12, intensity: 3, kind: point}}, {feetPosition: {x: 3.8, y: 6.3, z: -1}, fx: {script: "fx\npop smoke rate=3 on=disc(.2) life=3..5 v=up(.6) size=.3..0.5 acc=buoy(.3)+curl(.3)+drag(.5) sz=$size*(.6>2.6) col=<.42,.4,.38> a=0>.25:.25>0 r=sprite(smoke-puff,alpha)"}}]
  feetPosition: {x: -33, y: {terrain: -0.2}, z: 88}
  id: lodge-hall
  physics: static
  primitive: {kind: scripted, params: {kind: lodge}, script: scripts/gen/lodge.js}
  rotation: 180
  tags: [wayfarers-lodge]
