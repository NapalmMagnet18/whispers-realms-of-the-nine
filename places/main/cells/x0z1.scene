  primitive: {kind: scripted, params: {kind: sign}, script: scripts/gen/lodge.js}
  rotation: 170
  state: {mark: trail_sign, quest: PAT-01, say: The last post leans toward a thatched roof and a thin line of smoke., sound: /cdn/moodboard-painterly-fantasy/sfx-quest-objective-chime.mp3, title: Trail Sign, verb: Read the sign}
  tags: [quest-mark, wayfarers-lodge]
