  rotation: 180
  state: {mark: wolf_tracked, quest: PAT-02, say: Fresh. The prints quicken toward a thin glassy note in the reeds., sound: /cdn/moodboard-painterly-fantasy/sfx-footstep-mud-squelch.mp3, title: Bramblewolf Tracks, verb: Read the tracks}
  tags: [quest-mark, wayfarers-lodge]
