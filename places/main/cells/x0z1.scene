  primitive: {kind: scripted, params: {kind: sign}, script: scripts/gen/lodge.js}
  rotation: 190
  state: {mark: trail_sign, quest: PAT-01, say: "A second arrow, and under it a tiny wolf's head. Mind the bank.", sound: /cdn/moodboard-painterly-fantasy/sfx-quest-objective-chime.mp3, title: Trail Sign, verb: Read the sign}
  tags: [quest-mark, wayfarers-lodge]
pat-sign-2:
  feetPosition: {x: -30, y: {terrain: 0}, z: 81}
