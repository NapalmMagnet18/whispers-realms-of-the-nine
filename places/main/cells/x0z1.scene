pat-beacon:
  feetPosition: {x: -26.5, y: {terrain: 0}, z: 84}
  fx: {script: "fx\npop flame rate=10 on=disc(.04).c(1.6) life=.3..0.6 v=up(.4) size=.05..0.09 acc=buoy(1.2)+drag(1.5) sz=$size*(.6>1:.7>.2) col=hdr(3.6,2,.6)>hdr(1.6,.5,.1) a=0>.2:1>.7:.8>0 r=sprite(flame-wisp,add)\npop glow n=1 pos=<.26,1.6,0> r=light(<1,.7,.4>,2,9)"}
  id: pat-beacon
  physics: static
  primitive: {kind: scripted, params: {kind: beacon}, script: scripts/gen/lodge.js}
  rotation: 0
  state: {after: trail_sign, afterText: "First: follow the three trail signs here", mark: beacon_lit, quest: PAT-01, say: "The wick catches. Someone at the lodge window lifts a hand: safe road.", sound: /cdn/moodboard-painterly-fantasy/sfx-torch-ignite-whoosh.mp3, title: Beacon Cairn, verb: Light the beacon}
  tags: [quest-mark, wayfarers-lodge]
pat-cross-0:
  feetPosition: {x: -50, y: {terrain: 0}, z: 98}
  id: pat-cross-0
  physics: none
  primitive: {kind: scripted, params: {kind: shell}, script: scripts/gen/strand.js}
  rotation: 0
  state: {mark: crossing_surveyed, quest: PAT-03, say: "Your stick sinks to the elbow. Soft bottom, fast water. A cart would roll here.", sound: /cdn/moodboard-painterly-fantasy/sfx-water-splash-small.mp3, title: North Shallow, verb: Survey the crossing}
  tags: [quest-mark, wayfarers-lodge]
pat-cross-1:
  feetPosition: {x: -50, y: {terrain: 0}, z: 108}
  id: pat-cross-1
  physics: none
  primitive: {kind: scripted, params: {kind: shell}, script: scripts/gen/strand.js}
  rotation: 0
  state: {mark: crossing_surveyed, quest: PAT-03, say: "Gravel bar, knee-deep, steady. This one holds.", sound: /cdn/moodboard-painterly-fantasy/sfx-water-splash-small.mp3, title: South Shallow, verb: Survey the crossing}
  tags: [quest-mark, wayfarers-lodge]
pat-footpath:
  feetPosition: {x: -49, y: {terrain: 0}, z: 86}
  id: pat-footpath
  physics: none
  primitive: {kind: scripted, params: {kind: shell}, script: scripts/gen/strand.js}
  rotation: 0
  state: {mark: footpath_opened, quest: PAT-06, say: Ten minutes with a knife and the old boards show under the reeds again., sound: /cdn/moodboard-painterly-fantasy/sfx-grass-rustle-cut.mp3, title: Overgrown Footpath, verb: Cut the reeds back}
  tags: [quest-mark, wayfarers-lodge]
pat-guide-0:
  feetPosition: {x: -9.2, y: {terrain: 0}, z: 92.6}
  id: pat-guide-0
  physics: none
  primitive: {kind: scripted, params: {kind: stake}, script: scripts/gen/lodge.js}
  rotation: 0
  state: {mark: refugee_guided, quest: PAT-05, say: You point along the river. 'Slow is safe.' She nods and shoulders her bundle., sound: /cdn/moodboard-painterly-fantasy/sfx-quest-objective-chime.mp3, title: Traveler, verb: Show them the slow trail}
  tags: [quest-mark, wayfarers-lodge]
pat-guide-1:
  feetPosition: {x: -7.2, y: {terrain: 0}, z: 100.6}
  id: pat-guide-1
  physics: none
  primitive: {kind: scripted, params: {kind: stake}, script: scripts/gen/lodge.js}
  rotation: 0
  state: {mark: refugee_guided, quest: PAT-05, say: Two kids and a goat. The goat objects. The kids walk., sound: /cdn/moodboard-painterly-fantasy/sfx-quest-objective-chime.mp3, title: Traveler, verb: Show them the slow trail}
  tags: [quest-mark, wayfarers-lodge]
pat-guide-2:
  feetPosition: {x: -11.2, y: {terrain: 0}, z: 108.6}
  id: pat-guide-2
  physics: none
  primitive: {kind: scripted, params: {kind: stake}, script: scripts/gen/lodge.js}
  rotation: 0
  state: {mark: refugee_guided, quest: PAT-05, say: "'They told us the south road was closed.' 'It is,' you say. 'This way.'", sound: /cdn/moodboard-painterly-fantasy/sfx-quest-objective-chime.mp3, title: Traveler, verb: Show them the slow trail}
  tags: [quest-mark, wayfarers-lodge]
pat-lure:
  feetPosition: {x: -46, y: {terrain: 0}, z: 113}
  fx: {script: "fx\npop note rate=2 on=point().c(1.6) life=1..1.5 v=sdir()*.3 size=.15..0.25 col=hdr(.6,1.6,1) a=.6>0 sz=$size*(.5>2) r=sprite(soft-disc,add)"}
  id: pat-lure
  physics: static
  primitive: {kind: scripted, params: {kind: lure}, script: scripts/gen/lodge.js}
  rotation: 0
  state: {after: wolf_tracked, afterText: "First: follow the wolf's tracks along the bank", mark: lure_disabled, quest: PAT-02, say: "One tap and the bellglass cracks. The note stops. Far off in the briars, a wolf shakes its head and lopes home.", sound: /cdn/moodboard-painterly-fantasy/sfx-glass-shatter-small.mp3, title: Bellglass Lure, verb: Break the glass}
  tags: [quest-mark, wayfarers-lodge]
pat-mile-0:
  feetPosition: {x: -18, y: {terrain: 0}, z: 94}
  id: pat-mile-0
  physics: static
  primitive: {kind: scripted, params: {kind: marker}, script: scripts/gen/lodge.js}
  rotation: 90
  state: {mark: mile_marker, quest: PAT-04, say: "'IV to the Reach.' The moss is scraped off and the cut is sharp. Reset, and not long ago.", sound: /cdn/moodboard-painterly-fantasy/sfx-quest-objective-chime.mp3, title: Mile Marker, verb: Read the marker}
  tags: [quest-mark, wayfarers-lodge]
pat-mile-1:
  feetPosition: {x: -18, y: {terrain: 0}, z: 104}
  id: pat-mile-1
  physics: static
  primitive: {kind: scripted, params: {kind: marker}, script: scripts/gen/lodge.js}
  rotation: 90
  state: {mark: mile_marker, quest: PAT-04, say: "'V to the Reach.' Same fresh chisel marks. Someone walked this 'closed' road on purpose.", sound: /cdn/moodboard-painterly-fantasy/sfx-quest-objective-chime.mp3, title: Mile Marker, verb: Read the marker}
  tags: [quest-mark, wayfarers-lodge]
pat-report:
  feetPosition: {x: -33, y: {terrain: 0.4}, z: 84.6}
  id: pat-report
  physics: static
  primitive: {kind: scripted, params: {kind: board}, script: scripts/gen/cradle.js}
  rotation: 180
  state: {after: trail_trial, afterText: "First: roll past the three trial posts", mark: routes_reported, quest: PAT-07, say: "Safe route: the slow trail by the river. Closed route: the south road. Why it was closed, in full. You sign it.", sound: /cdn/moodboard-painterly-fantasy/sfx-quill-scratch-signature.mp3, title: Lodge Door Ledger, verb: Write both routes}
  tags: [quest-mark, wayfarers-lodge]
