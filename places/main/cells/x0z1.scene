  primitive: {kind: scripted, params: {kind: tracks}, script: scripts/gen/lodge.js}
  rotation: 180
  state: {mark: wolf_tracked, quest: PAT-02, say: "It stopped here, turned three times. Confused. Something keeps ringing it on.", sound: /cdn/moodboard-painterly-fantasy/sfx-footstep-mud-squelch.mp3, title: Bramblewolf Tracks, verb: Read the tracks}
  tags: [quest-mark, wayfarers-lodge]
