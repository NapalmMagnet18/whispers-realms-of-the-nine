qm-sor-chapel:
  feetPosition: {x: -1298, y: {terrain: 0.2}, z: 948}
  id: qm-sor-chapel
  primitive: {depth: 1, height: 1, kind: box, width: 1}
  state: {gain: Chapel explored, mark: chapel_entered, quest: SOR-06, say: "No altar. No pews. Only a stone shelf along the east wall where lanterns once stood in a row, dozens of them, their soot rings still on the stone.", title: the drowned chapel, verb: Search}
  tags: [quest-mark, sorrowfen]
  visible: false
qm-sor-echo:
  feetPosition: {x: -1238, y: 1.45, z: 866}
  id: qm-sor-echo
  material: {color: oklch(0.8 0.1 230), emissive: oklch(0.55 0.12 230)}
  primitive: {innerRadius: 1.1, kind: ring, outerRadius: 1.25}
  rotation: {pitch: -90}
  state: {burstAt: 0.2, burstFx: "fx\npop ring burst=60 on=arc(1.2,6.283,.05) life=1..1.6 v=up(.3..0.8) size=.05..0.1 acc=drag(1) col=hdr(.9,1.4,2.6) a=1>0 r=sprite(soft-disc,add)\npop glow n=1 life=1.6 r=light(<.5,.7,1>,12,12)", gain: The echo opens, mark: echo_entered, quest: SOR-08, say: "The splinter rings. The pool goes still as a mirror, then the mirror deepens, and the boardwalk in it is lit with lanterns that aren't lit up here. A small figure stands on the water.", title: Mourner Pool, verb: Hold the splinter over}
  tags: [quest-mark, sorrowfen]
qm-sor-eda:
  behavior: [scripts/townsfolk.js]
  children: [{feetPosition: {x: 0, y: 1, z: 0}, light: {color: oklch(0.75 0.1 230), distance: 6, intensity: 2, kind: point}}]
  feetPosition: {x: -1238, y: 1.45, z: 869}
  id: qm-sor-eda
  layout: {maxExtents: {x: 0.4, y: 1.2, z: 0.3}, minExtents: {x: -0.4, y: 0, z: -0.3}}
  model: /cdn/model-humanoid-fantasy-ghost-child-girl-translucent-pale-blue-nightdress-bare-feet.glb
  physics: {body: kinematic, collider: capsule}
  rotation: {yaw: 0}
  state: {after: echo_entered, afterText: "First: open the echo with the splinter", gain: Eda's testimony, homeYaw: 0, idle: Idle, mark: eda_spoken, npcName: Eda, quest: SOR-08, say: "\"I'm Eda. Eda Sable. Mama said wait by the water and she'd come back at dusk, with the lantern people. Is it dusk? It's always nearly dusk here.\"", title: the child in the echo, verb: Speak to, who: eda-fen, yaw: 0}
  tags: [quest-mark, townsfolk, sorrowfen]
qm-sor-lantern-c:
  feetPosition: {x: -1288.8, y: 2.3, z: 878}
  id: qm-sor-lantern-c
  physics: static
  primitive: {kind: scripted, params: {kind: lantern, lit: false, seed: 99}, script: scripts/gen/fen.js}
  state: {burstAt: 2, burstFx: "fx\npop flare burst=24 on=disc(.05) life=.4..0.9 v=up(1..2)+sdir()*.4 size=.05..0.1 acc=buoy(.6)+drag(1.2) col=hdr(4,2.6,.9)>hdr(1.6,.5,.1) a=1>0 r=sprite(flame-wisp,add)\npop glow n=1 life=1.5 r=light(<1,.6,.25>,10,10)", gain: Lantern lit, mark: ward_lantern, quest: SOR-01, say: "The wick catches. In the light you can read the thread stitched through it: a name, and a date that hasn't come yet.", title: A ward lantern, verb: Light}
  tags: [quest-mark, sorrowfen]
qm-sor-marker-c:
  feetPosition: {x: -1226, y: {terrain: 0}, z: 852}
  id: qm-sor-marker-c
  physics: static
  primitive: {kind: scripted, params: {kind: pole}, script: scripts/gen/fen.js}
  state: {gain: Marker planted, mark: evac_marker, quest: SOR-01, say: You drive the stake in and knot the pale rag high where the fog can't swallow it., title: An evacuation stake, verb: Plant}
  tags: [quest-mark, sorrowfen]
qm-sor-splinter:
  children: [{feetPosition: {x: 0, y: 0.3, z: 0}, light: {color: oklch(0.72 0.12 225), distance: 4, intensity: 1.5, kind: point}}]
  feetPosition: {x: -1262, y: 1.5, z: 905}
  id: qm-sor-splinter
  primitive: {kind: scripted, params: {kind: chime}, script: scripts/gen/fen.js}
  scale: 0.4
  state: {after: elite_mirelurker, afterText: "First: bring down the Mirelurker", gain: Splinter removed, mark: bellglass_splinter, quest: SOR-07, say: "A shard of blue bellglass as long as your hand, worked loose from where the beast's shell grew around it. It hums against your palm.", title: the bellglass splinter, verb: Pull out}
  tags: [quest-mark, sorrowfen]
qm-sor-step-1:
  feetPosition: {x: -1252, y: 1.5, z: 835}
  fx: {script: "fx\npop print n=2 on=box(.25,.01,.5) life=1.2..2 size=.12..0.2 col=hdr(.7,1.3,2.2) a=0>.3:.8>.7:.6>0 sz=$size r=sprite(soft-disc,add)\npop glow n=1 at=<0,.4,0> r=light(<.5,.75,1>,1.5,5)"}
  id: qm-sor-step-1
  state: {after: mourner_heard, afterText: "First: sit with Wenna at the pool's edge", gain: Footstep followed, mark: reflected_step, quest: SOR-03, say: The print is in the reflection only. Look up and the mud is bare., title: a reflected footstep, verb: Follow}
  tags: [quest-mark, sorrowfen]
qm-sor-stone-a:
  feetPosition: {x: -1306, y: {terrain: -0.1}, z: 934}
  id: qm-sor-stone-a
