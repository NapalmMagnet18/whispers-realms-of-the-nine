  state: {after: chapel_entered, afterText: "First: go inside the drowned chapel", gain: Stone read, mark: unmarked_stone, quest: SOR-06, say: "Under the moss, a line half-scraped away: '...walked in singing, so the rest would not be afraid.'", title: an unmarked stone, verb: Read}
