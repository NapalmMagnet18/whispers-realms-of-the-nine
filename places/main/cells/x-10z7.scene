qm-sor-lantern-c:
  feetPosition: {x: -1288.8, y: 1.3, z: 878}
  id: qm-sor-lantern-c
  physics: static
  primitive: {kind: scripted, params: {kind: lantern, lit: false, seed: 99}, script: scripts/gen/fen.js}
  state: {burstAt: 2, burstFx: "fx\npop flare burst=24 on=disc(.05) life=.4..0.9 v=up(1..2)+sdir()*.4 size=.05..0.1 acc=buoy(.6)+drag(1.2) col=hdr(4,2.6,.9)>hdr(1.6,.5,.1) a=1>0 r=sprite(flame-wisp,add)\npop glow n=1 life=1.5 r=light(<1,.6,.25>,10,10)", gain: Lantern lit, mark: ward_lantern, quest: SOR-01, say: "The wick catches. In the light you can read the thread stitched through it: a name, and a date that hasn't come yet.", title: A ward lantern, verb: Light}
  tags: [quest-mark, sorrowfen]
qm-sor-marker-c:
  feetPosition: {x: -1226, y: {terrain: 0}, z: 852}
  id: qm-sor-marker-c
  physics: static
  primitive: {kind: scripted, params: {kind: pole}, script: scripts/gen/fen.js}
  state: {gain: Marker planted, mark: evac_marker, quest: SOR-01, say: You drive the stake in and knot the pale rag high where the fog can't swallow it., title: An evacuation stake, verb: Plant}
  tags: [quest-mark, sorrowfen]
qm-sor-step-1:
  feetPosition: {x: -1252, y: 0.5, z: 835}
  fx: {script: "fx\npop print n=2 on=box(.25,.01,.5) life=1.2..2 size=.12..0.2 col=hdr(.7,1.3,2.2) a=0>.3:.8>.7:.6>0 sz=$size r=sprite(soft-disc,add)\npop glow n=1 at=<0,.4,0> r=light(<.5,.75,1>,1.5,5)"}
  id: qm-sor-step-1
  state: {after: mourner_heard, afterText: "First: sit with Wenna at the pool's edge", gain: Footstep followed, mark: reflected_step, quest: SOR-03, say: The print is in the reflection only. Look up and the mud is bare., title: a reflected footstep, verb: Follow}
  tags: [quest-mark, sorrowfen]
qm-sor-wenna:
  behavior: [scripts/townsfolk.js]
  feetPosition: {x: -1236, y: 1.3, z: 858.4}
  id: qm-sor-wenna
  layout: {maxExtents: {x: 0.4, y: 1.7, z: 0.3}, minExtents: {x: -0.4, y: 0, z: -0.3}}
  model: /cdn/model-humanoid-fantasy-mourner-female-black-shawl-veil-holding-unlit-candle.glb
  physics: {body: kinematic, collider: capsule}
  rotation: {yaw: 180}
  state: {gain: Wenna's story, homeYaw: 180, idle: Idle, mark: mourner_heard, npcName: Wenna the Mourner, quest: SOR-03, say: "\"Four of them. Tam and the little ones. The boat tipped where the reeds bend. Every dusk I see them walking home. In the water. Only in the water.\" She points: there, a footprint of light on the pool, where nothing has stepped.", title: Wenna the Mourner, verb: Sit with, who: wenna-fen, yaw: 180}
  tags: [quest-mark, townsfolk, sorrowfen]
qm-sor-wisp-a:
  children: [{feetPosition: {x: 0, y: 0.3, z: 0}, light: {color: oklch(0.75 0.12 240), distance: 6, intensity: 2, kind: point}}]
  feetPosition: {x: -1322, y: 1.4, z: 902}
  id: qm-sor-wisp-a
  state: {burstAt: 0.4, burstFx: "fx\npop motes burst=30 on=sphere(.2) life=.8..1.4 v=sdir()*(.6..1.2) size=.03..0.06 acc=drag(1.5) col=hdr(.8,1.6,3) a=1>0 r=sprite(soft-disc,add)", gain: A harmless wisp, mark: gentle_wisp, quest: SOR-02, say: "You hold still. The wisp drifts close and hums a few notes, like someone trying to remember a song.", title: a little blue wisp, verb: Listen to}
  tags: [quest-mark, sorrowfen]
  wisp: {burnStyle: calm, color: "#7fb8ff", seed: 3, shape: slender, size: 0.5, state: idle}
