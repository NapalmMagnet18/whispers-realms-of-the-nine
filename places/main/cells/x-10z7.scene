  rotation: -50
  state: {after: chapel_entered, afterText: "First: go inside the drowned chapel", gain: Stone read, mark: unmarked_stone, quest: SOR-06, say: "On the back, where no one would think to scrub: 'Promised by the Bellwright. Light for the lost.'", title: an unmarked stone, verb: Read}
