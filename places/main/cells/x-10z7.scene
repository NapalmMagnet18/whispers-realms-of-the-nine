# spawn-scene v2 yaml x-10z7
amb-sorrowfen-1:
  audio: {clip: /cdn/moodboard-painterly-fantasy/sfx-swamp-frogs-croaking-insects-buzzing-bubbling-mud-loop.mp3, gain: 0.18, loop: true, maxDistance: 160, spatial: true}
  feetPosition: {x: -1300, y: {terrain: 3}, z: 950}
  id: amb-sorrowfen-1
  tags: [ambience]
bell-gate:
  behavior: scripts/instance-gate.js
  children: [{feetPosition: {x: 0, y: 0, z: 0.1}, id: frame, material: {color: oklch(0.6 0.02 70), roughness: 0.95, texture: cdn/texture-dark-crypt-stone-blocks.png}, physics: static, primitive: {depth: 0.7, height: 3.9, kind: archway, thickness: 0.5, width: 3.4}}, {feetPosition: {x: 0, y: 4.2, z: 0}, id: glow, light: {color: oklch(0.78 0.11 190), distance: 12, intensity: 6, kind: point}}]
  feetPosition: {x: -1286, y: 1.31, z: 936}
  id: bell-gate
  material: {kind: scripted, script: engine/portal-ink, view: {link: "+drowned-bell#bell-gate-in", sound: 1, spill: 1.5}}
  physics: {body: static, trigger: true}
  primitive: {depth: 0.2, height: 3.3, kind: arch, width: 2.5}
  rotation: 0
  state: {enterQuest: DSB-01, enterTally: bell_entered, link: "+drowned-bell#bell-gate-in", minLevel: 22, name: The Drowned Bell}
  tags: [portal, instance-gate]
  ui: "<div face=\"top\" facing=\"player\" offset=\"0.5m\" width=\"1.6m\" class=\"flex flex-col items-center\"><div class=\"text-[56px] font-bold text-amber-100\" style=\"font-family:Cinzel,serif;text-shadow:0 3px 6px #000\">The Drowned Bell</div><div class=\"text-[34px] text-amber-200/80\" style=\"font-family:Cinzel,serif\">Dungeon · level 22+</div></div>"
