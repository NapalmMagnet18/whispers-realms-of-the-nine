qm-sor-wenna:
  behavior: [scripts/townsfolk.js]
  feetPosition: {x: -1236, y: 2.3, z: 858.4}
  id: qm-sor-wenna
  layout: {maxExtents: {x: 0.4, y: 1.7, z: 0.3}, minExtents: {x: -0.4, y: 0, z: -0.3}}
  model: /cdn/model-humanoid-fantasy-mourner-female-black-shawl-veil-holding-unlit-candle.glb
  physics: {body: kinematic, collider: capsule}
  rotation: {yaw: 180}
  state: {gain: Wenna's story, homeYaw: 180, idle: Idle, mark: mourner_heard, npcName: Wenna the Mourner, quest: SOR-03, say: "\"Four of them. Tam and the little ones. The boat tipped where the reeds bend. Every dusk I see them walking home. In the water. Only in the water.\" She points: there, a footprint of light on the pool, where nothing has stepped.", title: Wenna the Mourner, verb: Sit with, who: wenna-fen, yaw: 180}
  tags: [quest-mark, townsfolk, sorrowfen]
