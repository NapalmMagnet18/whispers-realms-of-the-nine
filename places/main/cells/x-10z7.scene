  feetPosition: {x: -1322, y: 2.4, z: 902}
  id: qm-sor-wisp-a
  state: {burstAt: 0.4, burstFx: "fx\npop motes burst=30 on=sphere(.2) life=.8..1.4 v=sdir()*(.6..1.2) size=.03..0.06 acc=drag(1.5) col=hdr(.8,1.6,3) a=1>0 r=sprite(soft-disc,add)", gain: A harmless wisp, mark: gentle_wisp, quest: SOR-02, say: "You hold still. The wisp drifts close and hums a few notes, like someone trying to remember a song.", title: a little blue wisp, verb: Listen to}
