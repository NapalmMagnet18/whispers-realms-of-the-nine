  primitive: {kind: scripted, params: {kind: stone, seed: 97}, script: scripts/gen/fen.js}
  rotation: -12
  state: {after: chapel_entered, afterText: "First: go inside the drowned chapel", gain: Stone read, mark: unmarked_stone, quest: SOR-06, say: "The face is rubbed smooth, but your fingers find one letter left in the corner: a V. For volunteer?", title: an unmarked stone, verb: Read}
