roost-starfall:
  children: [{feetPosition: {x: 2.6, y: 3.1, z: -2}, id: lamp, light: {color: oklch(0.85 0.15 70), distance: 14, intensity: 2.2, kind: point}}, {feetPosition: {x: -2.62, y: 3.4, z: -2.25}, id: sign, primitive: {height: 0.01, kind: plane, width: 0.01}, ui: "<div face=\"front\" emissive style=\"width:640px;text-align:center;font-family:serif;font-size:60px;line-height:1.1;color:#f2b04a;text-shadow:0 0 12px #000\">STARFALL EYRIE</div>", visible: true}, {feetPosition: {x: 0.4, y: 0.7, z: -0.6}, id: gryphon, layout: {maxExtents: {x: 1.2, y: 2.4, z: 1.8}, minExtents: {x: -1.2, y: 0, z: -1.8}}, model: /cdn/model-gryphon-perched-resting-wings-folded-eagle-head-lion-body-leather-saddle.glb, rotation: {yaw: 160}}, {feetPosition: {x: -1.6, y: 0.7, z: -2.4}, id: master, layout: {maxExtents: {x: 0.4, y: 1.8, z: 0.3}, minExtents: {x: -0.4, y: 0, z: -0.3}}, model: /cdn/model-humanoid-fantasy-roostmaster-female-leather-flight-cap-goggles-feather-cloak.glb, rotation: {yaw: 180}, state: {npcName: Roostmaster}, tags: [roostmaster]}]
  feetPosition: {x: -218, y: 120, z: -1102}
  id: roost-starfall
  physics: static
  primitive: {kind: scripted, script: scripts/gen/roost.js}
  state: {roost: starfall}
  tags: [roost]
start-starfall:
  feetPosition: {x: -200, y: {terrain: 0}, z: -1094}
  fx: {script: "fx\npop star n=?mobile:14|30 on=box(40,6,40).c(5) life=4..8 size=.04..0.08 acc=curl(.2)+drag(1.2) sz=$size*flick(5,.6) col=hdr(1.8,1.9,2.8) a=(0>.2:1>.8:1>0)*flick(1.5,.6) r=sprite(mote,add)"}
