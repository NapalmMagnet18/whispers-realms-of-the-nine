brd-bramble-crew:
  behavior: scripts/scavengers.js
  feetPosition: {x: -1124, y: 25, z: 44}
  id: brd-bramble-crew
  state: {crew: [{id: brd-bramble-1, x: -1122, yaw: 90, z: 48}, {id: brd-bramble-2, x: -1128, yaw: 60, z: 38}, {id: brd-bramble-3, x: -1131, yaw: 120, z: 52}], damage: 70, hp: 520, model: /cdn/model-creature-fantasy-bramble-guardian-thorny-vine-wolf-mossy-bark-glowing-amber-eyes.glb, name: Bramble Guardian, reward: {copper: 40, xp: 140}, scale: 1.3, tallyKey: bramble_calmed}
  tags: [deepgrove]
brd-firepit:
  audio: {clip: /cdn/moodboard-painterly-fantasy/sfx-campfire-crackle-loop.mp3, gain: 0.15, loop: true, maxDistance: 18, spatial: true}
  feetPosition: {x: -1058, y: 25, z: 54}
  fx: {script: "fx\npop coals n=8 on=disc(.25) size=.06..0.14 tint=<2.4,.9,.25>..<1.1,.3,.08> sz=$size*flick(.5,.12) col=$tint*flick(.8,.3) a=.9 r=sprite(soft-disc,add)\npop flame rate=flick(.45,.2)*60 on=disc(.22) life=.5..0.9 v=up(1.5)+cone(22)*(.3..0.8) size=.2..0.4 acc=curl(.5)*1.2+buoy(2.2)+drag(1.5) sz=$size*(.5>.25:1>.7:.7>.14) col=hdr(4.6,3.4,1.4)>.3:hdr(3.2,1.4,.3)>.65:hdr(1.8,.5,.1)>hdr(.6,.12,.03) a=0>.12:1>.75:.85>0 rot=spin(.2) r=sprite(flame-wisp,add)\npop embers rate=4 on=disc(.22) life=.7..1.4 v=up(2.2)+cone(30)*(.4..1.2) size=.02..0.05 acc=curl(.8)+grav()*.45+drag(.5) sz=$size*(1>.7:.8>.3) col=hdr(5,2.8,.8)>.6:hdr(2.4,.8,.15)>hdr(1,.22,.04) a=(0>.08:1>.65:.9>0)*flick(11,.35) r=sprite(ember,add,velocity,.02)\npop smoke on=@flame?.22 inh=p;v:$v*.4 life=1.8..3 size=.16..0.26 acc=buoy(.9)+curl(.35)*.5+drag(.8) sz=$size*(.7>3.2) col=<.3,.28,.26>><.15,.15,.16> a=0>.25:.3>.7:.2>0 rot=spin(.15) r=sprite(smoke-puff,alpha)\npop glow n=1 at=disc(.22).c(.45) glo=fire()*(#flame/40)~ r=light(<1,.55,.24>,$glo*30,12)"}
  id: brd-firepit
  physics: static
  primitive: {kind: scripted, params: {kind: firepit, seed: 4}, script: scripts/gen/grove.js}
  tags: [deepgrove]
brd-glowcaps:
  feetPosition: {x: -1085, y: 25, z: 62}
  fx: {script: "fx\npop mote n=?mobile:30|70 on=disc(45) life=4..7 v=up(.05..0.2)+sdir()*.1 size=.03..0.06 acc=curl(.3)*.4 pos=<0,.5..3,0> col=hdr(2.4,2,.6)>hdr(1,2.2,.8) a=(0>.2:1>.8:1>0)*flick(1.5,.4) r=sprite(soft-disc,add)"}
