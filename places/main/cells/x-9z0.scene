  primitive: {kind: scripted, params: {kind: pollen, seed: 21}, script: scripts/gen/grove.js}
  state: {gain: Lookout reached, mark: walkway_top, quest: BRD-06, say: "Wind in a hundred leaves, then, under it, a voice. West. Low. Patient. It is not calling you. It is reciting something.", title: the lookout, verb: Listen from}
  tags: [quest-mark, deepgrove]
qm-brd-memorial-gave:
  feetPosition: {x: -1074, y: 25, z: 82}
  id: qm-brd-memorial-gave
  physics: static
  primitive: {kind: scripted, params: {kind: memorial, seed: 18}, script: scripts/gen/grove.js}
  state: {after: gardener_helped, flag: brd_memorial_gave, gain: Memorial carved, mark: memorial_label, quest: BRD-05, say: "You carve it plain: THEY GAVE THEMSELVES TO THE GROVE. Hollen nods. Wyn says nothing, then lays a flower at its foot.", title: the memorial post, verb: "Carve \"They gave themselves\" on"}
  tags: [quest-mark, deepgrove]
qm-brd-memorial-given:
