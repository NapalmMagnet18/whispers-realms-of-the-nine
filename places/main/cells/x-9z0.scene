  state: {gain: Letter recovered, mark: court_letter_found, quest: BRD-07, say: "Black wax, the Hollow Court's seal. 'Lend me the grove's memory and I will give you back your dead, every one. M.'", title: a hollow stump, verb: Take the letter from}
  tags: [quest-mark, deepgrove]
qm-brd-echo:
  feetPosition: {x: -1080, y: 25.5, z: 104}
  id: qm-brd-echo
  state: {gain: Echo heard, mark: echo_spoken, quest: BRD-08, say: "'Everyone wants me to stand for something. My mother wants me home. The Accord wants me as proof. I just want someone to ask me first.'", title: the echo child, verb: Speak with}
  tags: [quest-mark, deepgrove]
  wisp: {burnStyle: calm, color: "#ffd9a0", shape: slender, size: 0.55, state: idle}
qm-brd-fiber:
  feetPosition: {x: -1082, y: 25, z: 90}
