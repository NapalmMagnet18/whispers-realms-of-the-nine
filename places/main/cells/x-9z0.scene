  primitive: {kind: scripted, params: {kind: lectern, seed: 10}, script: scripts/gen/grove.js}
  rotation: {yaw: 225}
  state: {after: inscription_read, gain: Letter compared, mark: letter_compared, quest: BRD-03, say: "Vale's letter, a mother's hand: 'my Eda wandered from the grove path.' The bark says otherwise.", title: Vale's reading stump, verb: Compare the letter on}
  tags: [quest-mark, deepgrove]
qm-brd-letter-stump:
  feetPosition: {x: -1106, y: 25, z: 44}
  id: qm-brd-letter-stump
  physics: static
  primitive: {kind: scripted, params: {kind: hollow, seed: 11}, script: scripts/gen/grove.js}
  state: {after: inscription_read, gain: Letter compared, mark: letter_compared, quest: BRD-03, say: "The second letter is the grove's own record. 'Given to the Ninth, as a witness, by the elders' leave.' The same date. The same girl.", title: a split stump, verb: Compare the letter in}
  tags: [quest-mark, deepgrove]
qm-brd-lookout:
  feetPosition: {x: -1122.4, y: 39.25, z: 90}
