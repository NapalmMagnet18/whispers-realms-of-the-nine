  state: {after: blight_cut, burstAt: 1.2, burstFx: "fx\npop mote burst=40 on=disc(.6) life=1.5..2.5 v=up(.6..1.4)+sdir()*.4 size=.04..0.08 acc=curl(.5)+drag(.6) col=hdr(3,2.2,.7)>hdr(1.2,2.4,.8) a=0>.1:1>0 r=sprite(soft-disc,add)\npop glow burst=1 life=1.6 r=light(<1,.8,.4>,10*(1>0),10)", gain: Root fibre preserved, mark: root_bound, quest: BRD-04, say: "You bind the pale cords with willow. The glow steadies, and the whole clearing seems to breathe out.", title: the healthy root fibre, verb: Bind}
  tags: [quest-mark, deepgrove]
qm-brd-hollen:
  behavior: [scripts/townsfolk.js]
  feetPosition: {x: -1066, y: 25, z: 74}
  id: qm-brd-hollen
