  state: {gain: Gardener helped, homeYaw: 135, idle: Idle, mark: gardener_helped, npcName: Gardener Hollen, quest: BRD-05, say: "You hold the ladder while Hollen ties up the fallen bough. 'They gave themselves,' he mutters. 'I won't have it said they were taken.'", title: Gardener Hollen, verb: Help, who: hollen-grove, yaw: 135}
  tags: [quest-mark, npc, townsfolk, deepgrove]
