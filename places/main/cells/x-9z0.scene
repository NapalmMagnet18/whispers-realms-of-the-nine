  primitive: {kind: scripted, params: {kind: memorial, seed: 19}, script: scripts/gen/grove.js}
  state: {after: gardener_helped, flag: brd_memorial_both, gain: Memorial carved, mark: memorial_label, quest: BRD-05, say: "You carve it: SOME GAVE THEMSELVES. SOME WERE GIVEN. WE REMEMBER BOTH. Wyn's hand rests on the words a long while.", title: the memorial post, verb: "Carve \"Some gave, some were given\" on"}
  tags: [quest-mark, deepgrove]
