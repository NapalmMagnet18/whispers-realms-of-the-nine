briarwild-leaf-fall-2:
  feetPosition: {x: -560, y: {terrain: 0}, z: 40}
  fx: {params: {height: 10, radius: 14, rate: 3}, script: "fx\npop leaves rate=%rate|3 on=disc(%radius|12).c(%height|9) life=7..11 v=up(-.4..-.8)+sdir()*.3 size=.14..0.24 fr=0..5.99 spin=-2..2 acc=curl(.5)*.9+drag(.6) a=0>.08:1>.85:1>0 sz=$size rot=$age*$spin floor=stick r=mesh(card,material=scripts/leaf-fall-look.js,params=fr:$fr)"}
  id: briarwild-leaf-fall-2
  tags: [fx]
