hc-reh-reedcage:
  feetPosition: {x: -392, y: 11.85, z: 541}
  id: hc-reh-reedcage
  physics: static
  primitive: {kind: scripted, params: {kind: reedcage}, script: scripts/gen/homeland.js, seed: 7}
