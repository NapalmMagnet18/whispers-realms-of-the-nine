  primitive: {kind: scripted, params: {kind: shrine, seed: 31}, script: scripts/gen/fen.js}
  state: {mark: reh_summons, quest: REH-10, say: Dark to the bottom. No wisps tonight. Not one., title: "The Memorial Pool, Gone Dark", verb: Examine}
