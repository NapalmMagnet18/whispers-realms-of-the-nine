qm-sor-chime-a:
  children: [{feetPosition: {x: 0, y: 0.4, z: 0}, light: {color: oklch(0.72 0.12 225), distance: 6, intensity: 2.5, kind: point}}]
  feetPosition: {x: -1300, y: 0.45, z: 801.5}
  id: qm-sor-chime-a
  primitive: {kind: scripted, params: {kind: chime}, script: scripts/gen/fen.js}
  state: {burstAt: 0.5, burstFx: "fx\npop ring burst=40 on=arc(.4,6.283,.05) life=.8..1.3 v=sdir()*(.3..0.6)+up(.6..1.2) size=.04..0.08 acc=drag(1) col=hdr(1,1.7,2.6) a=1>0 r=sprite(soft-disc,add)\npop glow n=1 life=1 r=light(<.6,.8,1>,8,8)", gain: Chime recovered, mark: bellglass_chime, quest: SOR-04, say: "You reach under the boat's stern and lift out a bell of blue glass. It is still ringing, very faintly, under your hand.", title: a sunken bellglass chime, verb: Recover}
  tags: [quest-mark, sorrowfen]
qm-sor-lantern-b:
  feetPosition: {x: -1222.8, y: 1.3, z: 829}
  id: qm-sor-lantern-b
  physics: static
  primitive: {kind: scripted, params: {kind: lantern, lit: false, seed: 98}, script: scripts/gen/fen.js}
  state: {burstAt: 2, burstFx: "fx\npop flare burst=24 on=disc(.05) life=.4..0.9 v=up(1..2)+sdir()*.4 size=.05..0.1 acc=buoy(.6)+drag(1.2) col=hdr(4,2.6,.9)>hdr(1.6,.5,.1) a=1>0 r=sprite(flame-wisp,add)\npop glow n=1 life=1.5 r=light(<1,.6,.25>,10,10)", gain: Lantern lit, mark: ward_lantern, quest: SOR-01, say: "The wick catches. In the light you can read the thread stitched through it: a name, and a date that hasn't come yet.", title: A ward lantern, verb: Light}
  tags: [quest-mark, sorrowfen]
