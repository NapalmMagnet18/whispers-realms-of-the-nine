# spawn-scene v2 yaml x-8z1
amb-deepgrove:
  audio: {clip: /cdn/moodboard-painterly-fantasy/sfx-ancient-grove-creaking-trunks-soft-wind-chimes-owl-hoots-loop.mp3, gain: 0.17, loop: true, maxDistance: 120, spatial: true}
  feetPosition: {x: -1085, y: {terrain: 3}, z: 64}
  id: amb-deepgrove
  tags: [ambience]
glade-deepgrove-1:
  overrides:
    feetPosition: {x: -1085, y: 25, z: 64}
    fx: {params: {b: 1.2, g: 1.8, lb: 0.7, lg: 1, lr: 0.45, r: 0.4, spread: 14}, script: "fx\npop wisp n=?low:3|6 on=disc(%spread|10).c(1.2) life=7..12 v=sdir()*(.15..0.3) size=.16..0.26 acc=curl(.12)*.9+noise(.3)*.25+drag(.6)+attract(.02)\n  sz=$size*flick(1.6,.35) col=<%r|0.55,%g|1.6,%b|2.4>*(.8>1.3:.5>.8) a=0>.15:1>.8:1>0 r=sprite(soft-disc,add)\npop halo on=@wisp?.35 inh=p life=.5..0.9 size=.5..0.8 col=<%r|0.55,%g|1.6,%b|2.4>*.25 a=.5>0 sz=$size*(.7>1.2) r=sprite(soft-disc,add)\npop trail on=@wisp?.9 inh=p life=.6..1.2 v=sdir()*.05 size=.03..0.06 acc=grav()*.03+drag(1) col=<%r|0.55,%g|1.6,%b|2.4>*.8 a=.8>0 r=sprite(mote,add)\npop firefly n=?low:8|18 on=disc(%spread|10).c(.6) life=4..8 v=sdir()*(.2..0.4) size=.035..0.06 acc=curl(.35)*1.2+drag(.9)\n  col=hdr(2.2,2.6,.6) a=(0>.1:1>.9:1>0)*(flick(.7,1)~) r=sprite(soft-disc,add)\npop pollen n=?low:14|40 on=box(%spread|10,2.2,%spread|10).c(1.6) life=8..14 v=sdir()*.05 size=.012..0.025 acc=curl(.08)*.25+wind()*.1+drag(.4)\n  col=<1,.92,.7> a=0>.2:.55>.8:.55>0 r=sprite(mote,add)\npop glow n=1 at=point().c(1.4) gl=(#wisp/6)~*flick(.4,.25) r=light(<%lr|0.5,%lg|0.85,%lb|1>,$gl*2.4,%spread|10)"}
  template: templates/glade.js#wisps
root-gate:
  behavior: scripts/instance-gate.js
  children: [{feetPosition: {x: 0, y: 0, z: 0.1}, id: frame, material: {color: oklch(0.6 0.02 70), roughness: 0.95, texture: cdn/texture-dark-crypt-stone-blocks.png}, physics: static, primitive: {depth: 0.7, height: 3.9, kind: archway, thickness: 0.5, width: 3.4}}, {feetPosition: {x: 0, y: 4.2, z: 0}, id: glow, light: {color: oklch(0.82 0.13 110), distance: 12, intensity: 6, kind: point}}]
  feetPosition: {x: -1072, y: 25, z: 68}
  id: root-gate
  material: {kind: scripted, script: engine/portal-ink, view: {link: "+root-archive#root-gate-in", sound: 1, spill: 1.5}}
  physics: {body: static, trigger: true}
  primitive: {depth: 0.2, height: 3.3, kind: arch, width: 2.5}
  rotation: 0
  state: {enterQuest: DRT-01, enterTally: root_entered, link: "+root-archive#root-gate-in", minLevel: 28, name: The Root Archive}
  tags: [portal, instance-gate]
  ui: "<div face=\"top\" facing=\"player\" offset=\"0.5m\" width=\"1.6m\" class=\"flex flex-col items-center\"><div class=\"text-[56px] font-bold text-amber-100\" style=\"font-family:Cinzel,serif;text-shadow:0 3px 6px #000\">The Root Archive</div><div class=\"text-[34px] text-amber-200/80\" style=\"font-family:Cinzel,serif\">Dungeon · level 28+</div></div>"
