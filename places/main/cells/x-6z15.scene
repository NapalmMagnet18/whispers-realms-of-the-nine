qm-tid-lens-turn:
  feetPosition: {x: -749, y: {terrain: 0}, z: 1951}
  id: qm-tid-lens-turn
  material: {color: oklch(0.4 0.01 60), metalness: 0.7, roughness: 0.5}
  physics: static
  primitive: {height: 0.12, kind: cylinder, radiusBottom: 0.5, radiusTop: 0.5}
  rotation: {pitch: 90}
  state: {after: lighthouse_lens, afterText: "First: light all three lenses", burstAt: 21, burstFx: "fx\npop ray burst=1 life=2.5 size=3 sz=$size*(.3>8) col=hdr(2.4,1.9,.9) a=.8>0 r=sprite(soft-disc,add)", gain: Lens turned inland, mark: lens_turned, quest: TID-02, say: "The rail groans, chain by chain. The beam swings off the dunes and settles, dead straight, on a dry valley inland where the old maps show a sea.", title: the lens rail, verb: Turn the crank of}
  tags: [quest-mark, tideglass]
