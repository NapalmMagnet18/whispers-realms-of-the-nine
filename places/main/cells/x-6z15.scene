# spawn-scene v2 yaml x-6z15
qm-tid-lens-a:
  feetPosition: {x: -733, y: {terrain: 0}, z: 1969}
  id: qm-tid-lens-a
  physics: static
  primitive: {kind: scripted, params: {kind: beacon}, script: scripts/gen/tide.js}
  state: {burstAt: 2.7, burstFx: "fx\npop spark burst=30 life=.5..1 v=sdir()*(1.5..3) size=.04..0.08 acc=grav()*.5+drag(1) col=hdr(4,2.4,.8)>hdr(1.5,.4,.1) a=1>0 r=sprite(ember,add,velocity,.02)\npop glow burst=1 life=.6 r=light(<1,.7,.4>,12*(1>0),12)", gain: Beacon lit, mark: lighthouse_lens, quest: TID-02, say: "The beacon's bowl of tideglass catches and glows pale blue, then gold.", title: a headland beacon, verb: Light}
  tags: [quest-mark, tideglass]
