  id: quarry-journal
  physics: static
  primitive: {kind: scripted, params: {kind: journal}, script: scripts/gen/quarry.js}
  rotation: {yaw: -20}
  state: {text: "The stone we cut on the lower face is not ours: it is dressed ashlar, squared and fitted by hands long dead, the same cold grey-red block they say lines the vaults of Hollowcrypt. Old Harl swears that when the hammers stop, you can hear something below tapping back.", title: Miner's Journal}
  tags: [readable]
