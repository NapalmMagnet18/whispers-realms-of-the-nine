  rotation: -150
  state: {after: shift_ledger, gain: Kiv confronted, mark: foreman_confront, quest: EQU-02, say: "Kiv won't meet your eye. \"Six picks short that night. I wrote what the Guild told me to write. ...I'm sorry.\"", title: Kiv's Tally Board, verb: Confront Kiv at}
