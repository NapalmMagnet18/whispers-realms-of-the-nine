# spawn-scene v2 yaml x-1z-8
bloom-star-1:
  feetPosition: {x: -166, y: {terrain: 0}, z: -1048}
  fx: {script: "fx\npop flies n=?mobile:3|7 on=disc(8).c(1) life=4..7 v=sdir()*.15 acc=curl(.6)*.5 size=.04..0.06 col=hdr(3,2.4,.8) a=(0>.2:1>.8:1>0)*flick(2,.6) sz=$size r=sprite(soft-disc,add)"}
  id: bloom-star-1
  scatter: {bounds: {radius: 9, shape: circle}, count: 40, templates: [{primitive: {kind: scripted, params: {kind: wildflowers, palette: star}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 5}, {primitive: {kind: scripted, params: {kind: lupine, palette: star}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 3}, {physics: {body: static, collider: auto}, primitive: {kind: scripted, params: {kind: blossom, palette: star}, script: scripts/gen/flora.js}, visibleRange: {max: 600, min: 0}, weight: 0.8}], variation: {scale: [0.8, 1.25], yaw: [0, 360]}}
  tags: [foliage, bloom]
star-road-shrine:
  children: [{feetPosition: {x: 0, y: 0.95, z: -0.6}, light: {color: oklch(0.85 0.12 70), distance: 6, intensity: 1.6, kind: point}}, {feetPosition: {x: 2.1, y: 0, z: -0.6}, physics: static, primitive: {kind: scripted, params: {kind: bench}, script: scripts/gen/props.js}, rotation: {yaw: 90}}]
  feetPosition: {x: -187.30818980731104, y: 96.88445437495555, z: -963.9832044511759}
  id: star-road-shrine
  physics: static
  primitive: {kind: scripted, script: scripts/gen/roadshrine.js, seed: 7}
  rotation: {lookAt: {x: -190.7695725828098, y: 96.96445437495555, z: -957.4052998242084}}
  tags: [shrine, landmark, roadside]
star-road-shrine/hum:
  audio: {clip: /cdn/moodboard-painterly-fantasy/sfx-wayside-shrine-soft-candle-crackle-gentle-wind-chimes-loop.mp3, gain: 0.16, loop: true, maxDistance: 14, spatial: true}
  feetPosition: {x: 0, y: 1, z: -0.4}
  id: star-road-shrine/hum
  parent: star-road-shrine
star-road-shrine/sign:
  feetPosition: {x: 0, y: 3.2, z: 0}
  id: star-road-shrine/sign
  parent: star-road-shrine
  vector: "<svg viewBox='0 0 240 40' width='2.4m' billboard='yaw'><rect x='2' y='2' width='236' height='36' rx='8' fill='#2a1e16' fill-opacity='0.82' stroke='#c9a46a' stroke-width='2'/><text x='120' y='27' text-anchor='middle' font-family='serif' font-size='18' fill='#f2d48a'>E · Wayfarer's Blessing</text></svg>"
  visibleRange: {max: 35}
starpool-basin:
  children: [{feetPosition: {x: 0, y: 0.32, z: 0}, material: {color: oklch(0.42 0.09 265), kind: water, opacity: 0.85, waveIntensity: 0.03}, primitive: {kind: circle, radius: 2.45, segments: 32}, rotation: {pitch: -90}}, {feetPosition: {x: 0, y: 0.4, z: 0}, fx: {script: "fx\npop stars n=?mobile:14|30 on=disc(2.2).c(.4) life=3..5 v=up(.05..0.15) size=.03..0.06 col=hdr(1.6,1.8,2.6) a=(0>.3:1>.7:1>0)*flick(3,.5) r=sprite(soft-disc,add)"}}, {feetPosition: {x: 0, y: 1.2, z: 0}, light: {color: oklch(0.82 0.08 255), distance: 14, intensity: 2.4, kind: point}}, {audio: {clip: /cdn/moodboard-painterly-fantasy/sfx-high-mountain-still-pool-soft-glass-chimes-thin-wind-loop.mp3, gain: 0.16, loop: true, maxDistance: 26, spatial: true}, feetPosition: {x: 0, y: 0.6, z: 0}}]
