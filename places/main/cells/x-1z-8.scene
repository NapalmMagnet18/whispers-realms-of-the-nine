# spawn-scene v2 yaml x-1z-8
bloom-star-1:
  feetPosition: {x: -166, y: {terrain: 0}, z: -1048}
  fx: {script: "fx\npop flies n=?mobile:3|7 on=disc(8).c(1) life=4..7 v=sdir()*.15 acc=curl(.6)*.5 size=.04..0.06 col=hdr(3,2.4,.8) a=(0>.2:1>.8:1>0)*flick(2,.6) sz=$size r=sprite(soft-disc,add)"}
  id: bloom-star-1
  scatter: {bounds: {radius: 9, shape: circle}, count: 40, templates: [{primitive: {kind: scripted, params: {kind: wildflowers, palette: star}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 5}, {primitive: {kind: scripted, params: {kind: lupine, palette: star}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 3}, {physics: {body: static, collider: auto}, primitive: {kind: scripted, params: {kind: blossom, palette: star}, script: scripts/gen/flora.js}, visibleRange: {max: 600, min: 0}, weight: 0.8}], variation: {scale: [0.8, 1.25], yaw: [0, 360]}}
  tags: [foliage, bloom]
vey-home-0:
  feetPosition: {x: -190, y: {terrain: -0.3}, z: -1085}
  id: vey-home-0
  model: /cdn/value.7d63086e18b439175cf078380cf56ba1ff2a5e36f2d1d1690b7b25df374025c3.glb
  physics: {body: static, collider: mesh}
  rotation: {yaw: 16}
