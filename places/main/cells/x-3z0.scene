# spawn-scene v2 yaml x-3z0
bloom-deepwood-2-a:
  feetPosition: {x: -347, y: {terrain: 0}, z: -13}
  fx: {script: "fx\npop petals rate=?mobile:1|2.5 on=disc(9).c(4) life=5..8 v=<.4,-.35,.2>+sdir()*.2 size=.05..0.08 spin=-4..4 acc=curl(.4)*.6+drag(.4) col=<1,.78,.85> a=0>.1:1>.85:1>0 sz=$size rot=$age*$spin floor=stick r=sprite(soft-disc,alpha)\npop flies n=?mobile:3|7 on=disc(8).c(1) life=4..7 v=sdir()*.15 acc=curl(.6)*.5 size=.04..0.06 col=hdr(3,2.4,.8) a=(0>.2:1>.8:1>0)*flick(2,.6) sz=$size r=sprite(soft-disc,add)"}
  id: bloom-deepwood-2-a
  scatter: {bounds: {radius: 13, shape: circle}, count: 70, templates: [{primitive: {kind: scripted, params: {kind: wildflowers}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 6}, {primitive: {kind: scripted, params: {kind: lupine}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 2.5}, {primitive: {kind: scripted, params: {kind: rosebush}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 1}, {physics: {body: static, collider: auto}, primitive: {kind: scripted, params: {kind: blossom}, script: scripts/gen/flora.js}, visibleRange: {max: 600, min: 0}, weight: 0.9}], variation: {scale: [0.8, 1.25], yaw: [0, 360]}}
  tags: [foliage, bloom]
