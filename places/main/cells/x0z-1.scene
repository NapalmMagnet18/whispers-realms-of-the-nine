# spawn-scene v2 yaml x0z-1
qm-sigil-spire:
  feetPosition: {x: 25, y: {terrain: 0}, z: -150}
  fx: {script: "fx\npop motes rate=5 on=disc(.5) life=1.4..2.2 v=up(.35..0.7) size=.04..0.08 acc=curl(.4)+drag(.6) col=hdr(2.6,1.9,.7) a=0>.2:1>.7:.8>0 sz=$size r=sprite(soft-disc,add)"}
  id: qm-sigil-spire
  physics: static
  primitive: {kind: scripted, params: {r: 0.45, tint: oklch(0.75 0.05 250)}, script: scripts/gen/rock.js}
  rotation: 175
  state: {gain: Sigil stone found, mark: sigil_stone, quest: Q007, say: Half buried by the road. The rune flickers when you lift it., title: Sigil Stone, verb: Take}
  tags: [quest-mark]
qm-ward-bell-roll:
  feetPosition: {x: -13.5, y: {terrain: 0}, z: -113.5}
  fx: {script: "fx\npop motes rate=5 on=disc(.5) life=1.4..2.2 v=up(.35..0.7) size=.04..0.08 acc=curl(.4)+drag(.6) col=hdr(2.6,1.9,.7) a=0>.2:1>.7:.8>0 sz=$size r=sprite(soft-disc,add)"}
  id: qm-ward-bell-roll
  physics: static
  primitive: {kind: scripted, params: {kind: table}, script: scripts/gen/props.js}
  rotation: 35
  state: {after: lost_notice, mark: bell_roll, quest: MAR-04, say: "Eda Sable. The Sables of Thirteen. The household at Twelve. All rung for on a single night: the First Silence.", title: The Bell Roll, verb: Read}
  tags: [quest-mark, lantern-ward]
qm-ward-census:
  feetPosition: {x: 5, y: {terrain: 0}, z: -79}
  fx: {script: "fx\npop motes rate=5 on=disc(.5) life=1.4..2.2 v=up(.35..0.7) size=.04..0.08 acc=curl(.4)+drag(.6) col=hdr(2.6,1.9,.7) a=0>.2:1>.7:.8>0 sz=$size r=sprite(soft-disc,add)"}
  id: qm-ward-census
  physics: static
  primitive: {kind: scripted, params: {kind: questboard}, script: scripts/gen/props.js}
  rotation: 200
  state: {mark: census_board, quest: MAR-01, say: "Bellward Lane, Nos. 1 to 11, every name in Elric's hand. Below Eleven, two lines scraped to bare wood. Your own name is there too, near the bottom, in fresh chalk.", title: Ward Census Board, verb: Examine}
  tags: [quest-mark, lantern-ward]
qm-ward-door-latch:
  feetPosition: {x: 29.4, y: {terrain: 0}, z: -100.8}
  id: qm-ward-door-latch
  material: {color: oklch(0.95 0.01 90), opacity: 0, transparent: true}
  primitive: {depth: 0.3, height: 0.05, kind: box, width: 0.3}
  state: {after: walled_door, mark: door_latch, quest: MAR-03, say: "The handle is warm. Behind the brick a voice says, very politely, that the bread may be left with a neighbour if no one wishes to come in.", title: The Handle, verb: Inspect}
  tags: [quest-mark, lantern-ward]
qm-ward-furnace:
  feetPosition: {x: -26, y: {terrain: 0}, z: -106}
  fx: {script: "fx\npop smoke rate=3 on=disc(.3).c(1.6) life=2..3.4 v=up(.5..0.9) size=.25..0.4 acc=buoy(.4)+curl(.3)+drag(.6) col=<.18,.17,.17> a=0>.25:.35>.7:.2>0 sz=$size*(.7>2.6) r=sprite(smoke-puff,alpha)"}
  id: qm-ward-furnace
  physics: static
  primitive: {kind: scripted, params: {kind: forge}, script: scripts/gen/props.js}
  rotation: 70
  state: {mark: furnace_soot, quest: MAR-06, say: "The soot comes away in flakes, black and glossy. Ink. Somebody burned paper here.", title: Old Ward Furnace, verb: Scrape}
  tags: [quest-mark, lantern-ward]
qm-ward-hesk:
  behavior: [scripts/townsfolk.js]
  feetPosition: {x: -15.5, y: {terrain: 0}, z: -95.4}
  id: qm-ward-hesk
  layout: {maxExtents: {x: 0.4, y: 1.8, z: 0.3}, minExtents: {x: -0.4, y: 0, z: -0.3}}
  model: /cdn/model-humanoid-fantasy-woodcutter-male-flannel-tunic-axe-belt.glb
  physics: {body: kinematic, collider: capsule}
  rotation: {yaw: 180}
  state: {__onSpawnRan: true, homeYaw: 180, idle: Idle_FoldArms_Loop, mark: ward_neighbour, npcName: Hesk the Cobbler, quest: MAR-02, say: "Thirteen? Never such a house. ...Dark-haired girl, mother worked late, father made toys from chair legs. What? I said nothing. Nothing at all.", title: Hesk the Cobbler, verb: Ask, who: hesk, yaw: 180}
  tags: [quest-mark, npc, lantern-ward]
qm-ward-maker-mark:
  feetPosition: {x: -24.6, y: {terrain: 0}, z: -108}
  id: qm-ward-maker-mark
  material: {color: oklch(0.95 0.01 90), opacity: 0, transparent: true}
  primitive: {depth: 0.3, height: 0.05, kind: box, width: 0.3}
  state: {after: furnace_soot, mark: maker_mark, quest: MAR-06, say: "Under the grime: a lantern inside a bell. The old Beacon Guild seal.", title: Brass Maker's Mark, verb: Polish}
  tags: [quest-mark, lantern-ward]
qm-ward-memorial-archive:
  feetPosition: {x: -14.5, y: 0.8, z: -124.5}
  fx: {script: "fx\npop motes rate=5 on=disc(.5) life=1.4..2.2 v=up(.35..0.7) size=.04..0.08 acc=curl(.4)+drag(.6) col=hdr(2.6,1.9,.7) a=0>.2:1>.7:.8>0 sz=$size r=sprite(soft-disc,add)"}
  id: qm-ward-memorial-archive
  physics: static
  primitive: {kind: scripted, params: {kind: chest}, script: scripts/gen/props.js}
  rotation: 20
  state: {flag: memorial_archived, mark: memorial_choice, quest: MAR-08, say: "You wrap the plaque in oilcloth and lock it in the archive chest. Recorded, kept, not shouted.", title: the plaque in the archive chest, verb: Seal}
  tags: [quest-mark, lantern-ward]
qm-ward-memorial-public:
  feetPosition: {x: -7.5, y: 0.8050936410772364, z: -123}
  fx: {script: "fx\npop motes rate=5 on=disc(.5) life=1.4..2.2 v=up(.35..0.7) size=.04..0.08 acc=curl(.4)+drag(.6) col=hdr(2.6,1.9,.7) a=0>.2:1>.7:.8>0 sz=$size r=sprite(soft-disc,add)"}
  id: qm-ward-memorial-public
  material: {color: oklch(0.7 0.03 80), texture: cdn/texture-mossy-fieldstone-wall.png}
  physics: static
  primitive: {height: 0.9, kind: cylinder, radiusBottom: 0.55, radiusTop: 0.45}
  state: {flag: memorial_public, mark: memorial_choice, quest: MAR-08, say: You set the plaque on the plinth facing the lane. Anyone walking to the bell will read it now., title: the plaque in the open, verb: Raise}
  tags: [quest-mark, lantern-ward]
qm-ward-notice-0:
  children: [{feetPosition: {x: 0, y: 1.25, z: -0.07}, material: {color: oklch(0.9 0.03 90), emissive: oklch(0.5 0.05 90), emissiveIntensity: 0.3}, primitive: {depth: 0.02, height: 0.6, kind: box, width: 0.45}}]
  feetPosition: {x: -24.6, y: {terrain: 0}, z: -95}
  fx: {script: "fx\npop motes rate=5 on=disc(.5) life=1.4..2.2 v=up(.35..0.7) size=.04..0.08 acc=curl(.4)+drag(.6) col=hdr(2.6,1.9,.7) a=0>.2:1>.7:.8>0 sz=$size r=sprite(soft-disc,add)"}
  id: qm-ward-notice-0
  material: {color: oklch(0.4 0.05 50)}
  physics: static
  primitive: {depth: 0.1, height: 1.6, kind: box, width: 0.1}
  state: {mark: lost_notice, quest: MAR-04, say: "HAVE YOU SEEN EDA SABLE, No. 13. A narrow girl, ink on her fingers. Dated tomorrow.", title: A nailed notice, verb: Take}
  tags: [quest-mark, lantern-ward]
qm-ward-notice-1:
  children: [{feetPosition: {x: 0, y: 1.25, z: -0.07}, material: {color: oklch(0.9 0.03 90), emissive: oklch(0.5 0.05 90), emissiveIntensity: 0.3}, primitive: {depth: 0.02, height: 0.6, kind: box, width: 0.45}}]
  feetPosition: {x: 6, y: {terrain: 0}, z: -111}
