  physics: static
  primitive: {depth: 0.1, height: 1.6, kind: box, width: 0.1}
  state: {mark: lost_notice, quest: MAR-04, say: "HAVE YOU SEEN THE SABLE FAMILY, No. 13, Bellward Lane. Dated tomorrow.", title: A notice on the well post, verb: Take}
  tags: [quest-mark, lantern-ward]
qm-ward-notice-2:
  children: [{feetPosition: {x: 0, y: 1.25, z: -0.07}, material: {color: oklch(0.9 0.03 90), emissive: oklch(0.5 0.05 90), emissiveIntensity: 0.3}, primitive: {depth: 0.02, height: 0.6, kind: box, width: 0.45}}]
  feetPosition: {x: -7, y: {terrain: 0}, z: -121}
  fx: {script: "fx\npop motes rate=5 on=disc(.5) life=1.4..2.2 v=up(.35..0.7) size=.04..0.08 acc=curl(.4)+drag(.6) col=hdr(2.6,1.9,.7) a=0>.2:1>.7:.8>0 sz=$size r=sprite(soft-disc,add)"}
  id: qm-ward-notice-2
