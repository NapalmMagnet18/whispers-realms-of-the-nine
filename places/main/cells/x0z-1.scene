  physics: static
  primitive: {depth: 0.1, height: 1.6, kind: box, width: 0.1}
  state: {mark: lost_notice, quest: MAR-04, say: "HAVE YOU SEEN No. 12? Its people were here. Dated tomorrow, in a hand you almost know.", title: A notice on the fence, verb: Take}
  tags: [quest-mark, lantern-ward]
qm-ward-parcel-0:
  feetPosition: {x: -20, y: {terrain: 0}, z: -104.6}
  fx: {script: "fx\npop motes rate=5 on=disc(.5) life=1.4..2.2 v=up(.35..0.7) size=.04..0.08 acc=curl(.4)+drag(.6) col=hdr(2.6,1.9,.7) a=0>.2:1>.7:.8>0 sz=$size r=sprite(soft-disc,add)"}
