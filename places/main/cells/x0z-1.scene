qm-ward-pell:
  behavior: [scripts/townsfolk.js]
  feetPosition: {x: 16, y: {terrain: 0}, z: -104}
  id: qm-ward-pell
  layout: {maxExtents: {x: 0.4, y: 1.75, z: 0.3}, minExtents: {x: -0.4, y: 0, z: -0.3}}
  model: /cdn/model-humanoid-fantasy-scholar-female-violet-robes-hood-tome.glb
  physics: {body: kinematic, collider: capsule}
  rotation: {yaw: 0}
  state: {__onSpawnRan: true, homeYaw: 0, idle: Idle_Lantern_Loop, mark: ward_neighbour, npcName: Widow Pell, quest: MAR-02, say: Thirteen had blue shutters. I brought them bread on feast days. ...Who did I bring it to?, title: Widow Pell, verb: Ask, who: pell, yaw: 0}
  tags: [quest-mark, npc, lantern-ward]
qm-ward-plaque:
  children: [{feetPosition: {x: 0, y: 0.25, z: -0.14}, material: {color: oklch(0.55 0.09 70), metalness: 0.8, roughness: 0.4}, primitive: {depth: 0.03, height: 0.6, kind: box, width: 1}, ui: "<div face='front' class='w-full h-full flex flex-col items-center justify-center font-serif text-center' style='color:#2a1e16'><div style='font-size:70px'>BELLWARD LANE</div><div style='font-size:46px'>Nos. 9 to 12</div><div style='font-size:40px'>Sealed in the Year of the First Silence</div></div>"}]
  feetPosition: {x: -11, y: 0.8, z: -124}
  id: qm-ward-plaque
  material: {color: oklch(0.55 0.02 120), texture: cdn/texture-mossy-fieldstone-wall.png}
  physics: static
  primitive: {depth: 0.25, height: 1.2, kind: box, width: 1.4}
  rotation: 20
  state: {mark: memorial_plaque, quest: MAR-07, say: "BELLWARD LANE, Nos. 12 and 13. SEALED FOR THE SAFETY OF THE WARD. Below, scratched small: signed, E.", title: Forgotten Plaque, verb: Read}
  tags: [quest-mark, lantern-ward]
qm-ward-shade-0:
  feetPosition: {x: -19.5, y: {terrain: 0}, z: -112.5}
  fx: {script: "fx\npop wisp rate=9 on=disc(.35) life=1.2..2 v=up(.5..1)+sdir()*.2 size=.08..0.16 acc=curl(.6)+drag(.8) col=hdr(.9,1.6,2.4) a=0>.2:.7>.7:.5>0 sz=$size r=sprite(soft-disc,add)\npop glow n=1 at=<0,1.1,0> r=light(<.55,.8,1>,3,6)"}
  id: qm-ward-shade-0
  material: {color: oklch(0.85 0.06 220), emissive: oklch(0.7 0.1 220), emissiveIntensity: 1.2, opacity: 0.35, transparent: true}
  primitive: {halfHeight: 0.55, kind: capsule, radius: 0.32}
  rotation: -40
  state: {after: storm_lamp, afterText: "First: light the storm lamps", mark: echo_shade, quest: MAR-05, say: "It flickers toward you and whispers: Sable, Eda. Number thirteen. The ship has three sails, not two. Then it is gone.", title: Echo Shade, verb: Steady}
  tags: [quest-mark, lantern-ward]
qm-ward-shade-1:
  feetPosition: {x: -13, y: {terrain: 0}, z: -119.5}
  fx: {script: "fx\npop wisp rate=9 on=disc(.35) life=1.2..2 v=up(.5..1)+sdir()*.2 size=.08..0.16 acc=curl(.6)+drag(.8) col=hdr(.9,1.6,2.4) a=0>.2:.7>.7:.5>0 sz=$size r=sprite(soft-disc,add)\npop glow n=1 at=<0,1.1,0> r=light(<.55,.8,1>,3,6)"}
  id: qm-ward-shade-1
  material: {color: oklch(0.85 0.06 220), emissive: oklch(0.7 0.1 220), emissiveIntensity: 1.2, opacity: 0.35, transparent: true}
  primitive: {halfHeight: 0.55, kind: capsule, radius: 0.32}
  rotation: 120
  state: {after: storm_lamp, afterText: "First: light the storm lamps", mark: echo_shade, quest: MAR-05, say: "It does not strike. It counts chairs, softly, and stops at fifteen. Then it is only lamplight.", title: Echo Shade, verb: Steady}
  tags: [quest-mark, lantern-ward]
qm-ward-storm-lamp-0:
  children: [{feetPosition: {x: 0, y: 3, z: 0}, light: {color: oklch(0.85 0.12 75), distance: 10, intensity: 3, kind: point}}]
  feetPosition: {x: -6, y: {terrain: 0}, z: -97.4}
  id: qm-ward-storm-lamp-0
  physics: static
  primitive: {kind: scripted, params: {kind: lamppost}, script: scripts/gen/props.js}
  state: {mark: storm_lamp, quest: MAR-05, say: "The wick takes. The flame leans east, toward the bricked door, though there is no wind.", title: Storm Lamp, verb: Light}
  tags: [quest-mark, lantern-ward]
qm-ward-storm-lamp-1:
  children: [{feetPosition: {x: 0, y: 3, z: 0}, light: {color: oklch(0.85 0.12 75), distance: 10, intensity: 3, kind: point}}]
