  rotation: 200
  state: {mark: census_board, quest: MAR-01, say: "Bellward Lane, Nos. 1 to 11, every name in Elric's hand. Below Eleven, two lines scraped to bare wood. Your own name is there too, near the bottom, in fresh chalk.", title: Ward Census Board, verb: Examine}
  tags: [quest-mark, lantern-ward]
qm-ward-door-latch:
  feetPosition: {x: 29.4, y: {terrain: 0}, z: -100.8}
  id: qm-ward-door-latch
  material: {color: oklch(0.95 0.01 90), opacity: 0, transparent: true}
  primitive: {depth: 0.3, height: 0.05, kind: box, width: 0.3}
  state: {after: walled_door, mark: door_latch, quest: MAR-03, say: "The handle is warm. Behind the brick a voice says, very politely, that the bread may be left with a neighbour if no one wishes to come in.", title: The Handle, verb: Inspect}
  tags: [quest-mark, lantern-ward]
