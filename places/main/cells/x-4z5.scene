# spawn-scene v2 yaml x-4z5
bloom-fen-3:
  feetPosition: {x: -454, y: {terrain: 0}, z: 613}
  fx: {script: "fx\npop flies n=?mobile:3|7 on=disc(8).c(1) life=4..7 v=sdir()*.15 acc=curl(.6)*.5 size=.04..0.06 col=hdr(3,2.4,.8) a=(0>.2:1>.8:1>0)*flick(2,.6) sz=$size r=sprite(soft-disc,add)"}
  id: bloom-fen-3
  scatter: {bounds: {radius: 9, shape: circle}, count: 40, templates: [{primitive: {kind: scripted, params: {kind: wildflowers, palette: fen}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 4}, {primitive: {kind: scripted, params: {kind: lupine, palette: fen}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 4}, {physics: {body: static, collider: auto}, primitive: {kind: scripted, params: {kind: willow, palette: fen}, script: scripts/gen/flora.js}, visibleRange: {max: 600, min: 0}, weight: 1.2}], variation: {scale: [0.8, 1.25], yaw: [0, 360]}}
  tags: [foliage, bloom]
