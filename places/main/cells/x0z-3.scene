# spawn-scene v2 yaml x0z-3
amb-spire:
  audio: {clip: /cdn/moodboard-painterly-fantasy/sfx-high-wind-moaning-through-ruined-stone-tower-faint-hum-loop.mp3, gain: 0.16, loop: true, maxDistance: 120, spatial: true}
  feetPosition: {x: 30, y: {terrain: 3}, z: -360}
  id: amb-spire
  tags: [ambience]
bloom-north-2-a:
  feetPosition: {x: 23, y: {terrain: 0}, z: -427}
  id: bloom-north-2-a
  scatter: {bounds: {radius: 13, shape: circle}, count: 70, templates: [{primitive: {kind: scripted, params: {kind: wildflowers}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 6}, {primitive: {kind: scripted, params: {kind: lupine}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 2.5}, {primitive: {kind: scripted, params: {kind: rosebush}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 1}, {physics: {body: static, collider: auto}, primitive: {kind: scripted, params: {kind: blossom}, script: scripts/gen/flora.js}, visibleRange: {max: 600, min: 0}, weight: 0.9}], variation: {scale: [0.8, 1.25], yaw: [0, 360]}}
  tags: [foliage, bloom]
bloom-north-2-b:
  feetPosition: {x: -20, y: {terrain: 0}, z: -414}
  id: bloom-north-2-b
  scatter: {bounds: {radius: 13, shape: circle}, count: 70, templates: [{primitive: {kind: scripted, params: {kind: wildflowers}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 6}, {primitive: {kind: scripted, params: {kind: lupine}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 2.5}, {primitive: {kind: scripted, params: {kind: rosebush}, script: scripts/gen/flora.js}, visibleRange: {max: 140, min: 0}, weight: 1}, {physics: {body: static, collider: auto}, primitive: {kind: scripted, params: {kind: blossom}, script: scripts/gen/flora.js}, visibleRange: {max: 600, min: 0}, weight: 0.9}], variation: {scale: [0.8, 1.25], yaw: [0, 360]}}
  tags: [foliage, bloom]
far-spire:
  feetPosition: {x: 30, y: {terrain: -2}, z: -360}
  id: far-spire
  physics: static
  primitive: {kind: scripted, script: scripts/gen/spire.js}
  rotation: 20
  tags: [landmark]
  visibleRange: {max: 2000, min: 0}
