# spawn-scene v2 yaml x-6z1
amb-thornhollow:
  audio: {clip: /cdn/moodboard-painterly-fantasy/sfx-deep-forest-wind-through-pine-boughs-woodpecker-distant-birds-loop.mp3, gain: 0.15, loop: true, maxDistance: 90, spatial: true}
  feetPosition: {x: -720, y: {terrain: 3}, z: 70}
  id: amb-thornhollow
  tags: [ambience]
glade-npc-ell:
  behavior: [scripts/townsfolk.js]
  feetPosition: {x: -726, y: {terrain: 0}, z: 76}
  id: glade-npc-ell
