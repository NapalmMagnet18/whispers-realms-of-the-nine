hc-thr-flame:
  feetPosition: {x: -722.8, z: 65.2}
  fx: {script: "fx\npop glow n=1 at=<0,.7,0> r=light(<1.6,1.1,.5>,1.6,5)\npop mote rate=3 on=disc(.5) life=1.5..2.5 v=up(.3..0.6) size=.04..0.08 acc=curl(.4)+drag(.6) col=<1.6,1.1,.5>*2 a=0>.6:.6>0 r=sprite(soft-disc,add)"}
  id: hc-thr-flame
  primitive: {kind: scripted, params: {kind: lantern, seed: 9}, script: scripts/gen/fen.js}
  state: {mark: thr_ninth_flame, quest: THR-20, say: The flame settles in. For a breath every light at home burns a little brighter., title: The Ninth Flame, verb: Set the flame}
  tags: [quest-mark, homecoming]
hc-thr-mark-0:
  feetPosition: {x: -713.7, z: 85.9}
  fx: {script: "fx\npop glow n=1 at=<0,.7,0> r=light(<.6,1,.3>,1.6,5)\npop mote rate=3 on=disc(.5) life=1.5..2.5 v=up(.3..0.6) size=.04..0.08 acc=curl(.4)+drag(.6) col=<.6,1,.3>*2 a=0>.6:.6>0 r=sprite(soft-disc,add)"}
