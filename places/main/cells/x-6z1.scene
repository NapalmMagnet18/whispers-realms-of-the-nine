  rotation: {yaw: 0}
  state: {mark: rot_bloom, quest: THR-11, say: The bloom hisses and folds. The soil under it smells like rain again., title: Weeping Rot-Bloom, verb: Burn out}
  tags: [quest-mark, homecoming]
hc-thr-summons:
