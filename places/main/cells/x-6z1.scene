  physics: {body: kinematic, collider: capsule}
  rotation: {yaw: 120}
  state: {homeYaw: 120, idle: Idle, npcName: Grove Singer Ell, who: ell, yaw: 120}
  tags: [npc, talker, townsfolk, quest-npc, rootwake-glade]
