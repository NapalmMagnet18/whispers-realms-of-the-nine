# spawn-scene v2 yaml x-6z1
start-thornhollow:
  feetPosition: {x: -720, y: 19.585919813131138, z: 70}
  fx: {script: "fx\npop moth n=?mobile:14|28 on=box(17,2.2,17).c(2.6) life=5..9 size=.05..0.09 acc=curl(.35)*1.6+drag(1.1) sz=$size*flick(4,.5) col=hdr(2.6,2,.75) a=(0>.15:1>.8:1>0)*flick(1.3,.5) r=sprite(mote,add)\npop glim n=?mobile:4|8 on=box(14,1.5,14).c(1.2) life=4..7 size=.12..0.2 acc=curl(.2)+drag(1.4) sz=$size col=hdr(1.2,1.6,.9) a=(0>.3:.6>.7:.6>0)*flick(.7,.6) r=sprite(soft-disc,add)"}
  id: start-thornhollow
  physics: static
  primitive: {kind: scripted, params: {kind: plate}, script: scripts/gen/hamlet.js}
  tags: [start-zone, thornhollow]
