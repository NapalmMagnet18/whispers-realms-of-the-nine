ah-hall:
  children: [{feetPosition: {x: 0, y: 2.4, z: 0}, light: {color: oklch(0.82 0.13 65), distance: 10, intensity: 4, kind: point}}]
  feetPosition: {x: 51.5, y: 0.95, z: 41}
  id: ah-hall
  physics: static
  primitive: {kind: scripted, params: {chimney: 1, d: 8, doorX: 0, h: 4.6, rise: 2.6, roof: weathered red clay roof shingles, stories: 1, w: 11, wall: stone, win: 2}, script: scripts/gen/house.js}
  rotation: 90
  tags: [building, auction-house]
ah-npc-auctioneer:
  behavior: [scripts/townsfolk.js]
  feetPosition: {x: 46, y: {terrain: 0}, z: 41}
  id: ah-npc-auctioneer
  layout: {maxExtents: {x: 0.4, y: 1.8, z: 0.3}, minExtents: {x: -0.4, y: 0, z: -0.3}}
  model: /cdn/model-humanoid-fantasy-auctioneer-man-gilded-waistcoat-ledger-book-spectacles.glb
  physics: {body: kinematic, collider: capsule}
  rotation: {yaw: 90}
  state: {homeYaw: 90, idle: Idle_FoldArms_Loop, npcName: Auctioneer Pell Varrow, yaw: 90}
  tags: [npc, auctioneer, interactable]
ah-sign:
  feetPosition: {x: 46.85, y: 5, z: 41}
  id: ah-sign
  rotation: 90
  tags: [sign]
  vector: "<svg viewBox='0 0 300 70' width='3.4m'><rect x='4' y='4' width='292' height='62' rx='8' fill='#2a1e16' stroke='#c9a46a' stroke-width='5'/><text x='150' y='33' font-family='serif' font-size='24' fill='#f2b04a' text-anchor='middle'>THE LANTERN EXCHANGE</text><text x='150' y='56' font-family='serif' font-size='15' fill='#e8d9b5' text-anchor='middle'>Auction House of the Reach</text></svg>"
amb-reach-square:
  audio: {clip: /cdn/moodboard-painterly-fantasy/sfx-medieval-town-square-murmuring-crowd-cart-wheels-church-bell-far-loop.mp3, gain: 0.14, loop: true, maxDistance: 70, spatial: true}
  feetPosition: {x: 0, y: {terrain: 3}, z: 0}
  id: amb-reach-square
  tags: [ambience]
arc-bench:
  feetPosition: {x: -18, y: {terrain: 0}, z: -30.5}
  id: arc-bench
  physics: static
  primitive: {kind: scripted, params: {kind: bench}, script: scripts/gen/observatory.js}
  rotation: -20
  tags: [observatory]
arc-consent-bram:
  feetPosition: {x: 14.1, y: 4, z: -31.300000000000004}
  id: arc-consent-bram
  physics: none
  primitive: {kind: scripted, params: {kind: shell}, script: scripts/gen/strand.js}
  rotation: 0
  state: {mark: consent_asked, quest: ARC-03, say: "Bram thinks about it a long while. 'Yes. Only today, mind.' You read the smell of bread and a door he still locks twice.", sound: /cdn/moodboard-painterly-fantasy/sfx-quest-objective-chime.mp3, title: Ask Permission, verb: Ask to read a trace}
  tags: [quest-mark, observatory]
arc-consent-mira:
  feetPosition: {x: 19.099999999999998, y: 4, z: 4.4}
  id: arc-consent-mira
  physics: none
  primitive: {kind: scripted, params: {kind: shell}, script: scripts/gen/strand.js}
  rotation: 0
  state: {mark: consent_asked, quest: ARC-03, say: "'Go on, then. Gently.' Mira holds still. You read heat, and a song her father sang at the anvil.", sound: /cdn/moodboard-painterly-fantasy/sfx-quest-objective-chime.mp3, title: Ask Permission, verb: Ask to read a trace}
  tags: [quest-mark, observatory]
arc-consent-rowan:
  feetPosition: {x: -35.6, y: 4.4, z: -11.299999999999999}
  id: arc-consent-rowan
  physics: none
  primitive: {kind: scripted, params: {kind: shell}, script: scripts/gen/strand.js}
  rotation: 0
  state: {mark: consent_asked, quest: ARC-03, say: "'Ask the river first,' Rowan says, and grins, and nods. You read thirty years of a single crossing.", sound: /cdn/moodboard-painterly-fantasy/sfx-quest-objective-chime.mp3, title: Ask Permission, verb: Ask to read a trace}
  tags: [quest-mark, observatory]
arc-credit:
  feetPosition: {x: -18, y: {terrain: 0.5}, z: -30.5}
  id: arc-credit
  physics: none
  primitive: {kind: scripted, params: {kind: shell}, script: scripts/gen/strand.js}
  rotation: 0
  state: {after: focus_trial, afterText: "First: hold your focus at the three plinths", mark: author_credited, quest: ARC-07, say: "You write it plainly on the card: 'Written by those who kept the lamps. Names unknown. Honored.'", sound: /cdn/moodboard-painterly-fantasy/sfx-quill-scratch-signature.mp3, title: Reading Bench, verb: Credit the author}
  tags: [quest-mark, observatory]
arc-desk:
  feetPosition: {x: -30.6, y: {terrain: 0}, z: -37.8}
  id: arc-desk
  physics: static
  primitive: {kind: scripted, params: {kind: desk}, script: scripts/gen/observatory.js}
  rotation: 90
  state: {after: ink_fragment, afterText: "First: copy the three ink fragments", mark: page_stabilized, quest: ARC-04, say: "You lay the three copies over the page. The ink slows, shivers, and stops. 'Here, by our own hands, we kept the lamps.'", sound: /cdn/moodboard-painterly-fantasy/sfx-paper-unfold.mp3, title: Ossa's Desk, verb: Pin the page}
  tags: [quest-mark, observatory]
arc-device:
  feetPosition: {x: -28, y: {terrain: 0}, z: -31}
  fx: {script: "fx\npop mote rate=3 on=sphere(.25) life=1..1.6 v=up(.15) size=.04..0.08 col=hdr(1.6,1.8,3) a=0>1:.4>0 r=sprite(soft-disc,add)"}
  id: arc-device
  physics: static
  primitive: {kind: scripted, params: {kind: plinth}, script: scripts/gen/observatory.js}
  rotation: 0
  state: {after: consent_asked, afterText: "First: ask three people for permission", mark: forced_refused, quest: ARC-03, say: A brass cage of needles that reads whoever stands near. It purrs at you. You close its lid and turn the key the wrong way., sound: /cdn/moodboard-painterly-fantasy/sfx-brass-compass-click.mp3, title: Reading Device, verb: Refuse it}
  tags: [quest-mark, observatory]
arc-echo-0:
  feetPosition: {x: -34, y: {terrain: 0}, z: -46}
  fx: {script: "fx\npop mote rate=3 on=sphere(.25) life=1..1.6 v=up(.15) size=.04..0.08 col=hdr(1.6,1.8,3) a=0>1:.4>0 r=sprite(soft-disc,add)"}
  id: arc-echo-0
  physics: static
  primitive: {kind: scripted, params: {kind: echo}, script: scripts/gen/observatory.js}
  rotation: 0
  state: {mark: echo_released, quest: ARC-01, say: A woman laughing at a joke you'll never hear the start of. You let it go. It drifts off over the river., sound: /cdn/moodboard-painterly-fantasy/sfx-soft-magical-chime-release.mp3, title: Memory Echo, verb: "Listen, then release"}
  tags: [quest-mark, observatory]
arc-echo-1:
  feetPosition: {x: -15, y: {terrain: 0}, z: -47}
  fx: {script: "fx\npop mote rate=3 on=sphere(.25) life=1..1.6 v=up(.15) size=.04..0.08 col=hdr(1.6,1.8,3) a=0>1:.4>0 r=sprite(soft-disc,add)"}
  id: arc-echo-1
  physics: static
  primitive: {kind: scripted, params: {kind: echo}, script: scripts/gen/observatory.js}
  rotation: 40
  state: {mark: echo_released, quest: ARC-01, say: "Rain on a slate roof, and a child counting the drips. You open your hand. The sound goes quiet, gently.", sound: /cdn/moodboard-painterly-fantasy/sfx-soft-magical-chime-release.mp3, title: Memory Echo, verb: "Listen, then release"}
  tags: [quest-mark, observatory]
arc-echo-2:
  feetPosition: {x: -29, y: {terrain: 0}, z: -53}
  fx: {script: "fx\npop mote rate=3 on=sphere(.25) life=1..1.6 v=up(.15) size=.04..0.08 col=hdr(1.6,1.8,3) a=0>1:.4>0 r=sprite(soft-disc,add)"}
  id: arc-echo-2
  physics: static
  primitive: {kind: scripted, params: {kind: echo}, script: scripts/gen/observatory.js}
  rotation: 80
  state: {mark: echo_released, quest: ARC-01, say: "Someone humming while they mend a net. You listen to the whole verse, then let it leave.", sound: /cdn/moodboard-painterly-fantasy/sfx-soft-magical-chime-release.mp3, title: Memory Echo, verb: "Listen, then release"}
  tags: [quest-mark, observatory]
