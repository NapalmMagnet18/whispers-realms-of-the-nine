  primitive: {kind: scripted, params: {kind: shell}, script: scripts/gen/strand.js}
  rotation: 0
  state: {after: resonance_signal, afterText: "First: listen to both lamps", mark: false_lamp, quest: ARC-02, say: "Your hand on the brass. The lamp flickers, embarrassed, and its shadow snaps back to where it belongs.", sound: /cdn/moodboard-painterly-fantasy/sfx-soft-magical-chime-release.mp3, title: The Lying Lamp, verb: Mark the liar}
