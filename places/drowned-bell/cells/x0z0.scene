qm-dsb-air-0:
  feetPosition: {x: -5, y: 0.05, z: -29}
  fx: {params: {b: 2.2, g: 2.4, r: 1.6}, script: "fx\npop body rate=24 on=sphere(.25) life=.6..1.1 v=sdir()*.2 size=.08..0.16 acc=curl(.6)+drag(1) col=hdr(1.2,2.4,2.6) a=0>.3:.6>.7:.4>0 r=sprite(soft-disc,add)\npop glow n=1 at=<0,.2,0> r=light(<.5,.9,1>,1.4,6)"}
  id: qm-dsb-air-0
  rotation: 0
  state: {burstAt: 1, burstFx: "fx\npop flare burst=36 on=sphere(.3) life=.5..1.1 v=up(1..2.4)+sdir()*.6 size=.06..0.12 acc=buoy(.4)+drag(1.2) col=hdr(2.6,2.2,1.2)>hdr(1,.5,.2) a=1>0 r=sprite(soft-disc,add)\npop glow n=1 life=1 r=light(<1,.8,.5>,10,10)", gain: Air pocket opened, mark: air_pocket, quest: DSB-02, say: Stale air rushes up through the floodwater. The chamber breathes again., title: A sealed air bell, verb: Open}
  tags: [quest-mark, drowned-bell]
