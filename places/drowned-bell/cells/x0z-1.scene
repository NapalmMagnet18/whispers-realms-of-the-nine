# spawn-scene v2 yaml x0z-1
bell-amb-2:
  audio: {clip: /cdn/moodboard-gothic-horror/sfx-crypt-water-drips-echo-faint-stone-grind-distant-wind-loop.mp3, gain: 0.16, loop: true, maxDistance: 45, spatial: true}
  feetPosition: {x: 0, y: 2, z: -66}
  id: bell-amb-2
  tags: [ambience]
bell-brazier-2-2-e:
  children: [{feetPosition: {x: 0, y: 2.1, z: 0}, id: light, light: {color: oklch(0.82 0.12 75), distance: 15, intensity: 14, kind: point}}]
  feetPosition: {x: 11.6, y: 0, z: -71}
  fx: {script: "fx\npop flame rate=26 on=disc(.28) life=.4..0.8 v=up(1.1..1.8)+cone(18)*.3 size=.18..0.32 acc=curl(.5)+buoy(1.6)+drag(1.4) sz=$size*(.5>1:.6>.2) col=hdr(4,2.6,1)>hdr(2.2,.8,.2)>hdr(.5,.1,.02) a=0>.15:1>.7:.8>0 r=sprite(flame-wisp,add)"}
  id: bell-brazier-2-2-e
  physics: static
  primitive: {kind: scripted, params: {kind: brazier, layout: drowned-bell}, script: scripts/gen/instance.js}
bell-brazier-2-2-w:
  children: [{feetPosition: {x: 0, y: 2.1, z: 0}, id: light, light: {color: oklch(0.82 0.12 75), distance: 15, intensity: 14, kind: point}}]
  feetPosition: {x: -11.6, y: 0, z: -71}
  fx: {script: "fx\npop flame rate=26 on=disc(.28) life=.4..0.8 v=up(1.1..1.8)+cone(18)*.3 size=.18..0.32 acc=curl(.5)+buoy(1.6)+drag(1.4) sz=$size*(.5>1:.6>.2) col=hdr(4,2.6,1)>hdr(2.2,.8,.2)>hdr(.5,.1,.02) a=0>.15:1>.7:.8>0 r=sprite(flame-wisp,add)"}
  id: bell-brazier-2-2-w
  physics: static
  primitive: {kind: scripted, params: {kind: brazier, layout: drowned-bell}, script: scripts/gen/instance.js}
bell-drowned-bell:
  children: [{feetPosition: {x: 0, y: 1.5, z: 0}, id: glow, light: {color: oklch(0.75 0.13 190), distance: 16, intensity: 10, kind: point}}]
  feetPosition: {x: 0, y: 3.6, z: -77}
  id: bell-drowned-bell
  physics: static
  primitive: {kind: scripted, params: {kind: bell, layout: drowned-bell}, script: scripts/gen/instance.js}
  rotation: 15
bell-flood-2:
  feetPosition: {x: 0, y: 0.14, z: -66}
  id: bell-flood-2
  material: {color: oklch(0.45 0.07 195), kind: water, opacity: 0.55, waveIntensity: 0.25}
  primitive: {height: 27.6, kind: plane, width: 25.6}
  rotation: {pitch: -90}
