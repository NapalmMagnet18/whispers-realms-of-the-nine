# spawn-scene v2 yaml x0z0
mm-altar:
  feetPosition: {x: 0, y: {terrain: 0}, z: -3}
  id: mm-altar
  material: {color: oklch(0.55 0.01 80), repeat: [1, 1], roughness: 0.95, texture: cdn/texture-weathered-grey-ashlar-stone.png}
  physics: static
  primitive: {depth: 1.2, height: 0.9, kind: box, width: 2.4}
mm-banner:
  feetPosition: {x: 0, y: {terrain: 0.9}, z: -3.4}
  id: mm-banner
  material: {color: "#a4161a", roughness: 0.9}
  primitive: {depth: 0.05, height: 2.6, kind: box, width: 0.9}
mm-fire:
  audio: {clip: cdn/moodboard-painterly-fantasy/sfx-campfire-crackle.mp3, gain: 0.15, loop: true, maxDistance: 20, spatial: true}
  feetPosition: {x: 2.5, y: {terrain: 0}, z: 2}
  fx: {script: "fx\npop flame rate=50 on=disc(.3) life=.5..0.9 v=up(1.5)+cone(22)*(.3..0.8) size=.25..0.45 acc=curl(.5)*1.2+buoy(2.2)+drag(1.5) sz=$size*(.5>.25:1>.7:.7>.14) col=hdr(4.6,3.4,1.4)>.3:hdr(3.2,1.4,.3)>.65:hdr(1.8,.5,.1)>hdr(.6,.12,.03) a=0>.12:1>.75:.85>0 rot=spin(.2) r=sprite(flame-wisp,add)\npop embers rate=5 on=disc(.3) life=.8..1.5 v=up(2.2)+cone(30)*(.4..1.2) size=.02..0.05 acc=curl(.8)+grav()*.45+drag(.5) col=hdr(5,2.8,.8)>hdr(1,.22,.04) a=(0>.08:1>.65:.9>0)*flick(11,.35) r=sprite(ember,add,velocity,.02)\npop glow n=1 at=disc(.1).c(.6) r=light(<1,.55,.24>,25*flick(.6,.2),14)"}
  id: mm-fire
  material: {color: oklch(0.3 0.01 80), roughness: 1}
  primitive: {height: 0.25, kind: cylinder, radiusBottom: 0.7, radiusTop: 0.6}
