rg-embers:
  feetPosition: {x: 0, y: 0.5, z: -14}
  fx: {script: "fx\npop embers n=?mobile:60|140 on=box(18,6,14).c(6) wrap=36;12;28 life=6..10 v=<0,.25,0>+sdir()*.15 size=.025..0.05 acc=curl(.25)*.4+wind()*.15\n  sz=$size col=hdr(3.6,1.8,.45)>hdr(1.6,.5,.1) a=(0>.15:1>.8:1>0)*flick(3,.5) r=sprite(ember,add)"}
  id: rg-embers
  tags: [realm-gate]
rg-fire-l:
  feetPosition: {x: -6, y: 2.3, z: -18.5}
  fx: {script: "fx\npop flame rate=flick(.45,.2)*60 on=disc(.45) life=.5..0.95 v=up(1.8)+cone(24)*(.35..0.9) size=.35..0.6 acc=curl(.5)*1.3+buoy(2.4)+drag(1.5)\n  sz=$size*(.5>.25:1>.7:.72>.14) col=hdr(4.8,3.6,1.5)>.3:hdr(3.4,1.5,.35)>.65:hdr(1.9,.55,.12)>hdr(.7,.14,.03) a=0>.12:1>.75:.85>0 rot=spin(.2) r=sprite(flame-wisp,add)\npop embers rate=6 on=disc(.4) life=1..2 v=up(2.6)+cone(32)*(.4..1.3) size=.02..0.05 acc=curl(.8)*1.1+grav()*.3+drag(.5)\n  sz=$size*(1>.7:.8>.3) col=hdr(5,2.8,.8)>.6:hdr(2.4,.8,.15)>hdr(1,.22,.04) a=(0>.08:1>.65:.9>0)*flick(11,.35) r=sprite(ember,add,velocity,.02)\npop smoke on=@flame?.2 inh=p;v:$v*.4 life=2..3.5 size=.25..0.4 acc=buoy(.9)+curl(.35)*.5+drag(.8) sz=$size*(.7>3.4) col=<.3,.28,.26>><.15,.15,.16> a=0>.22:.3>.7:.18>0 rot=spin(.15) r=sprite(smoke-puff,alpha)\npop hearth n=1 at=disc(.2).c(.6) glo=fire()*(#flame/40)~ r=light(<1,.55,.24>,$glo*45,16)"}
  id: rg-fire-l
  tags: [realm-gate]
rg-fire-r:
  feetPosition: {x: 6, y: 2.3, z: -18.5}
  fx: {script: "fx\npop flame rate=flick(.45,.2)*60 on=disc(.45) life=.5..0.95 v=up(1.8)+cone(24)*(.35..0.9) size=.35..0.6 acc=curl(.5)*1.3+buoy(2.4)+drag(1.5)\n  sz=$size*(.5>.25:1>.7:.72>.14) col=hdr(4.8,3.6,1.5)>.3:hdr(3.4,1.5,.35)>.65:hdr(1.9,.55,.12)>hdr(.7,.14,.03) a=0>.12:1>.75:.85>0 rot=spin(.2) r=sprite(flame-wisp,add)\npop embers rate=6 on=disc(.4) life=1..2 v=up(2.6)+cone(32)*(.4..1.3) size=.02..0.05 acc=curl(.8)*1.1+grav()*.3+drag(.5)\n  sz=$size*(1>.7:.8>.3) col=hdr(5,2.8,.8)>.6:hdr(2.4,.8,.15)>hdr(1,.22,.04) a=(0>.08:1>.65:.9>0)*flick(11,.35) r=sprite(ember,add,velocity,.02)\npop smoke on=@flame?.2 inh=p;v:$v*.4 life=2..3.5 size=.25..0.4 acc=buoy(.9)+curl(.35)*.5+drag(.8) sz=$size*(.7>3.4) col=<.3,.28,.26>><.15,.15,.16> a=0>.22:.3>.7:.18>0 rot=spin(.15) r=sprite(smoke-puff,alpha)\npop hearth n=1 at=disc(.2).c(.6) glo=fire()*(#flame/40)~ r=light(<1,.55,.24>,$glo*45,16)"}
  id: rg-fire-r
  tags: [realm-gate]
