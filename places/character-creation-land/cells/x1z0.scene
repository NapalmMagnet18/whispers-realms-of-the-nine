# spawn-scene v2 yaml x1z0
ws-air:
  feetPosition: {x: 85.2, y: 0, z: 10.8}
  fx: {script: "fx\npop motes n=?low:30|70 on=box(3.2,1.6,3.6).c(1.9) life=5..9 v=sdir()*.05 size=.01..0.022 acc=curl(.15)*.25+buoy(.02) sz=$size*flick(.8,.3) col=hdr(2.2,1.5,.6) a=0>.2:.8>.8:.8>0 r=sprite(mote,add)\npop mist n=?low:5|9 on=box(5,.05,5).c(.15) life=8..12 v=sdir()*.06 size=1.1..1.7 acc=curl(.08)*.15+drag(.4) sz=$size*(.8>1.2) col=<.55,.53,.65> a=0>.1:.3>.14:.65>0 rot=spin(.02) r=sprite(smoke-puff,alpha,,,1.5)"}
  id: ws-air
ws-apse:
  feetPosition: {x: 85.4, y: 0, z: 10.812}
  id: ws-apse
  material: {pbr: true}
  primitive: {kind: scripted, params: {part: apse}, script: scripts/gen/wayshrine.js}
ws-apse-fill:
  feetPosition: {x: 86, y: 2.2, z: 10.8}
  id: ws-apse-fill
  light: {color: oklch(0.6 0.08 270), distance: 9, intensity: 3, kind: point}
ws-banner-1:
  castShadow: false
  feetPosition: {x: 86.72, y: 5.5, z: 7.1}
  id: ws-banner-1
  material: {pbr: true}
  primitive: {kind: scripted, params: {h: 2.6, part: banner, phase: 0, w: 1}, script: scripts/gen/wayshrine.js}
  rotation: {yaw: 90}
ws-banner-2:
  castShadow: false
  feetPosition: {x: 89.6, y: 4.7, z: 14.2}
  id: ws-banner-2
  material: {pbr: true}
  primitive: {kind: scripted, params: {h: 2.2, part: banner, phase: 1.7, w: 0.85}, script: scripts/gen/wayshrine.js}
  rotation: {yaw: 105}
ws-candles-0:
  castShadow: false
  feetPosition: {x: 82.15, y: 0.74, z: 10}
  id: ws-candles-0
  material: {pbr: true}
  primitive: {kind: scripted, params: {n: 4, part: candles, seed: 0}, script: scripts/gen/wayshrine.js}
ws-candles-1:
  castShadow: false
  feetPosition: {x: 82.35, y: 0.74, z: 12}
  id: ws-candles-1
  material: {pbr: true}
  primitive: {kind: scripted, params: {n: 5, part: candles, seed: 3}, script: scripts/gen/wayshrine.js}
ws-candles-2:
  castShadow: false
  feetPosition: {x: 87.6, y: 0, z: 8.3}
  id: ws-candles-2
  material: {pbr: true}
  primitive: {kind: scripted, params: {n: 6, part: candles, seed: 5}, script: scripts/gen/wayshrine.js}
ws-candles-3:
  castShadow: false
  feetPosition: {x: 88.2, y: 0, z: 13.9}
  id: ws-candles-3
  material: {pbr: true}
  primitive: {kind: scripted, params: {n: 4, part: candles, seed: 7}, script: scripts/gen/wayshrine.js}
ws-dais:
  feetPosition: {x: 84.2, y: 0, z: 10.812}
  id: ws-dais
  material: {pbr: true}
  physics: static
  primitive: {kind: scripted, params: {part: dais}, script: scripts/gen/wayshrine.js}
ws-fill:
  feetPosition: {x: 81.6, y: 2.4, z: 11.6}
  id: ws-fill
  light: {color: oklch(0.82 0.08 70), distance: 7, intensity: 5, kind: point}
ws-ground:
  feetPosition: {x: 84.2, y: 0, z: 10.812}
  id: ws-ground
  material: {pbr: true}
  physics: static
  primitive: {kind: scripted, params: {part: ground}, script: scripts/gen/wayshrine.js}
ws-key:
  feetPosition: {x: 82, y: 3.7, z: 8.9}
  id: ws-key
  light: {aim: {x: 84.5, y: 2.4, z: 10.8}, angle: 36, color: "#f2b04a", distance: 16, intensity: 95, kind: spot, penumbra: 0.7, shadow: {enabled: true}}
ws-lantern-l:
  feetPosition: {x: 83.9, y: 0, z: 7.6}
  id: ws-lantern-l
  material: {pbr: true}
  primitive: {kind: scripted, params: {part: lantern}, script: scripts/gen/wayshrine.js}
ws-lantern-l-flame:
  feetPosition: {x: 83.9, y: 3, z: 7.6}
  fx: {script: "fx\npop flame rate=flick(.5,.25)*14 on=disc(.06) life=.3..0.5 v=up(.3) size=.06..0.1 acc=curl(.4)+buoy(.6) sz=$size*(.6>1:.5>.2) col=hdr(3.2,1.8,.5)>hdr(1.6,.6,.12) a=0>.2:.8>0 r=sprite(flame-wisp,add)\npop embers rate=1.2 on=disc(.08) life=1.4..2.6 v=up(.5..0.9)+sdir()*.15 size=.012..0.024 acc=curl(.6)*.8+buoy(.15)+drag(.6) sz=$size col=hdr(4,2.2,.6)>hdr(1.4,.4,.08) a=(0>.1:1>.7:.8>0)*flick(9,.4) r=sprite(ember,add)\npop glow n=1 at=point() glo=fire()*(.6+#flame/20)~ r=light(<1,.69,.29>,$glo*4,9)"}
  id: ws-lantern-l-flame
ws-lantern-r:
  feetPosition: {x: 86.3, y: 0, z: 13.5}
  id: ws-lantern-r
  material: {pbr: true}
  primitive: {kind: scripted, params: {part: lantern}, script: scripts/gen/wayshrine.js}
ws-lantern-r-flame:
  feetPosition: {x: 86.3, y: 3, z: 13.5}
  fx: {script: "fx\npop flame rate=flick(.5,.25)*14 on=disc(.06) life=.3..0.5 v=up(.3) size=.06..0.1 acc=curl(.4)+buoy(.6) sz=$size*(.6>1:.5>.2) col=hdr(3.2,1.8,.5)>hdr(1.6,.6,.12) a=0>.2:.8>0 r=sprite(flame-wisp,add)\npop embers rate=1.2 on=disc(.08) life=1.4..2.6 v=up(.5..0.9)+sdir()*.15 size=.012..0.024 acc=curl(.6)*.8+buoy(.15)+drag(.6) sz=$size col=hdr(4,2.2,.6)>hdr(1.4,.4,.08) a=(0>.1:1>.7:.8>0)*flick(9,.4) r=sprite(ember,add)\npop glow n=1 at=point() glo=fire()*(.6+#flame/20)~ r=light(<1,.69,.29>,$glo*4,9)"}
  id: ws-lantern-r-flame
ws-pines:
  castShadow: false
  feetPosition: {x: 84.2, y: 0, z: 10.812}
  id: ws-pines
  material: {pbr: true}
  primitive: {kind: scripted, params: {count: 70, gap: -26, hill: [115.8, -57.5], part: pines}, script: scripts/gen/wayshrine.js}
ws-rim:
  feetPosition: {x: 87.4, y: 4.2, z: 12.9}
  id: ws-rim
  light: {aim: {x: 84.5, y: 2, z: 10.8}, angle: 30, color: oklch(0.72 0.13 285), distance: 12, intensity: 55, kind: spot, penumbra: 0.6}
