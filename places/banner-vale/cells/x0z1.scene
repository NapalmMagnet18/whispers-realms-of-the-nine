# spawn-scene v2 yaml x0z1
banner-gold:
  children: [{feetPosition: {x: 0.7, y: 3, z: 0}, id: light, light: {color: "#f2b04a", distance: 10, intensity: 2.5, kind: point}}]
  feetPosition: {x: 0, y: 3.1, z: 96}
  id: banner-gold
  interpolation: {teleportThreshold: 30}
  primitive: {kind: scripted, params: {color: "#f2b04a"}, script: scripts/gen/war-banner.js}
  rotation: 90
  tags: [bg-banner]
board-gold:
  children: [{feetPosition: {x: 0, y: 1.03, z: -0.1}, id: face, material: {color: "#2a1e16"}, primitive: {depth: 0.02, height: 1.05, kind: box, width: 2.3}, state: {v: {}}, tags: [bg-board], ui: "<div face=\"front\" class=\"w-[2400px] h-[1100px] flex flex-col items-center bg-[#2a1e16] border-[8px] border-[#c9a46a] rounded-xl\">\n<div class=\"text-[70px] font-bold text-[#f2b04a] pt-[20px]\" style=\"font-family:Cinzel,serif\">BANNER VALE</div>\n<div class=\"text-[44px] text-[#e8d9b5]\">{{ state.v.banner | default \"First to 3\" }} · {{ state.v.clock | default \"12:00\" }}</div>\n<div class=\"flex w-full justify-around pt-[40px]\">\n<div class=\"flex flex-col items-center\"><div class=\"text-[56px] text-[#f2b04a]\" style=\"font-family:Cinzel,serif\">LANTERN GOLD</div><div class=\"text-[260px] font-bold text-[#f2b04a]\">{{ state.v.gold | default 0 }}</div><div class=\"text-[38px] text-[#e8d9b5]\">banner: {{ state.v.goldFlag | default \"home\" }}</div></div>\n<div class=\"flex flex-col items-center\"><div class=\"text-[56px] text-[#d0473a]\" style=\"font-family:Cinzel,serif\">CRIMSON WARDENS</div><div class=\"text-[260px] font-bold text-[#d0473a]\">{{ state.v.crimson | default 0 }}</div><div class=\"text-[38px] text-[#e8d9b5]\">banner: {{ state.v.crimsonFlag | default \"home\" }}</div></div>\n</div></div>"}]
  feetPosition: {x: -9, y: 3, z: 95}
  id: board-gold
  physics: static
  primitive: {kind: scripted, params: {kind: questboard}, script: scripts/gen/props.js}
  rotation: 25
fire-gold:
  audio: {clip: /cdn/moodboard-painterly-fantasy/sfx-campfire-crackle-loop.mp3, gain: 0.2, loop: true, maxDistance: 18, spatial: true}
  children: [{feetPosition: {x: 0, y: 0.8, z: 0}, id: light, light: {color: "#ff9a3c", distance: 12, intensity: 3, kind: point}}]
  feetPosition: {x: 0, y: 3, z: 110}
  id: fire-gold
  physics: static
  primitive: {kind: scripted, params: {kind: cookfire}, script: scripts/gen/camp.js}
home-gate-gold:
  behavior: scripts/instance-gate.js
  children: [{feetPosition: {x: 0, y: 0, z: 0.1}, id: frame, material: {color: oklch(0.6 0.02 70), roughness: 0.95, texture: cdn/texture-dark-crypt-stone-blocks.png}, physics: static, primitive: {depth: 0.7, height: 3.9, kind: archway, thickness: 0.5, width: 3.4}}]
  feetPosition: {x: 9, y: 2.9862370440393393, z: 118}
  id: home-gate-gold
  material: {kind: scripted, script: engine/portal-ink, view: {link: "+main", sound: 1, spill: 1.5}}
  physics: {body: static, collider: box, trigger: true}
  primitive: {depth: 0.4, height: 3.4, kind: box, width: 2.6}
  rotation: 180
  state: {link: "+main", name: Leave Banner Vale}
  tags: [portal, instance-gate]
